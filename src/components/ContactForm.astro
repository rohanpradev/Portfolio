---
import { POSTMARK_FROM_EMAIL, POSTMARK_SERVER_TOKEN } from "astro:env/server";
import { site } from "../data/meta";

interface Props {
  redirectTo?: string;
}

const { redirectTo = "/contact" } = Astro.props as Props;
const referer = Astro.request.headers.get("Referer");
const refererUrl = referer ? new URL(referer) : null;
const sent = refererUrl?.searchParams.get("sent") === "1";
const error = refererUrl?.searchParams.get("error");
const postmarkReady = Boolean(POSTMARK_SERVER_TOKEN && POSTMARK_FROM_EMAIL);

const errorMessages: Record<string, string> = {
  validation: "Please provide a valid name, email address, and project brief before sending.",
  unavailable: "The email service is not configured yet. Use direct email for now.",
  provider: "The message could not be sent right now. Please try again or use direct email.",
  network: "A network error interrupted the request. Please try again.",
};

const message =
  sent
    ? { kind: "success", text: "Your message was sent successfully. Expect a reply through the email address you provided." }
    : error
      ? { kind: "error", text: errorMessages[error] ?? "Something went wrong while sending the message." }
      : null;
---

<div class="surface-card-strong grid gap-5 p-6 sm:p-7">
  <div>
    <p class="eyebrow">Server-Delivered Contact</p>
    <h3 class="mt-4 text-2xl font-semibold text-slate-900">Send a real message through a secure Postmark-backed endpoint.</h3>
    <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">
      This form is rendered as a deferred server island, so the rest of the page stays static and fast while the mail flow still runs securely on the server.
    </p>
  </div>

  {message && (
    <div class:list={[
      "rounded-[24px] border px-4 py-3 text-sm",
      message.kind === "success"
        ? "border-emerald-200 bg-emerald-50 text-emerald-800"
        : "border-rose-200 bg-rose-50 text-rose-800",
    ]}>
      {message.text}
    </div>
  )}

  {postmarkReady ? (
    <form class="grid gap-5" method="post" action="/api/contact">
      <input type="hidden" name="redirectTo" value={redirectTo} />

      <label class="sr-only">
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>

      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-2 text-sm font-medium text-slate-700">
          Name
          <input
            name="name"
            autocomplete="name"
            required
            class="rounded-2xl border border-slate-900/10 bg-white/85 px-4 py-3 text-slate-900 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
            placeholder="Your name"
          />
        </label>

        <label class="grid gap-2 text-sm font-medium text-slate-700">
          Email
          <input
            type="email"
            name="email"
            autocomplete="email"
            required
            class="rounded-2xl border border-slate-900/10 bg-white/85 px-4 py-3 text-slate-900 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
            placeholder="you@example.com"
          />
        </label>
      </div>

      <div class="grid gap-5 sm:grid-cols-[1fr_15rem]">
        <label class="grid gap-2 text-sm font-medium text-slate-700">
          Company or team
          <input
            name="company"
            autocomplete="organization"
            class="rounded-2xl border border-slate-900/10 bg-white/85 px-4 py-3 text-slate-900 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
            placeholder="Where is this project happening?"
          />
        </label>

        <label class="grid gap-2 text-sm font-medium text-slate-700">
          Engagement
          <select
            name="engagement"
            class="rounded-2xl border border-slate-900/10 bg-white/85 px-4 py-3 text-slate-900 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
          >
            <option>Full-stack delivery</option>
            <option>Frontend architecture</option>
            <option>API and backend integration</option>
            <option>Azure and cloud-native work</option>
            <option>AI and RAG integration</option>
          </select>
        </label>
      </div>

      <label class="grid gap-2 text-sm font-medium text-slate-700">
        Project brief
        <textarea
          name="message"
          rows="6"
          required
          minlength="20"
          class="rounded-[24px] border border-slate-900/10 bg-white/85 px-4 py-3 text-slate-900 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
          placeholder="Share the product context, timeline, team shape, architecture constraints, or the outcome you need."
        ></textarea>
      </label>

      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="text-sm text-slate-500">Messages are sent server-side through Postmark and delivered to {site.email}.</p>
        <button type="submit" class="primary-button">Send inquiry</button>
      </div>
    </form>
  ) : (
          <div class="rounded-[20px] border border-slate-900/8 bg-white/80 p-5">
      <p class="text-sm leading-7 text-slate-600">
        Postmark environment variables are not configured yet, so the form is unavailable in this environment.
        Use direct email for now.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`mailto:${site.email}`} class="primary-button">Email directly</a>
        <a href={site.social.linkedin} target="_blank" rel="noreferrer" class="secondary-button">LinkedIn</a>
      </div>
    </div>
  )}
</div>
