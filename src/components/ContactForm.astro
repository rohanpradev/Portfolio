---
import { site } from "../data/meta";
import CopyEmail from "./CopyEmail.astro";
---

<div class="contact-compose surface-card-strong">
  <p class="micro-label">Start a conversation</p>
  <h2>
    Good work starts
    <br />
    with a <span class="serif-text">good conversation.</span>
  </h2>
  <p>
    Tell me what you’re building, the role you have in mind, or the problem
    you’re trying to solve.
  </p>
  <div class="contact-direct">
    <a href={`mailto:${site.email}`} class="primary-button">
      Email Rohan <span aria-hidden="true">↗</span>
    </a>
    <CopyEmail />
  </div>
  <p class="contact-address">{site.email}</p>
  <div class="contact-note">
    <p class="micro-label">A useful first message</p>
    <ul>
      <li>A little about your team and product.</li>
      <li>The role or engineering challenge.</li>
      <li>Your timeline and how we could work together.</li>
    </ul>
  </div>
</div>
<style>
  .contact-compose {
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .contact-compose h2 {
    font-size: clamp(1.8rem, 3.2vw, 3rem);
    line-height: 1.1;
    margin-top: 1.5rem;
  }
  .contact-compose > p:not(.micro-label) {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-600);
    margin-top: 1.2rem;
  }
  .contact-direct {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .contact-address {
    overflow-wrap: anywhere;
  }
  .contact-note {
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding-top: 1.5rem;
  }
  .contact-note ul {
    list-style: disc;
    padding-left: 1rem;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--text-600);
    line-height: 2;
  }
</style>
