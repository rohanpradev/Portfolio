---
import { site } from "../data/meta";

const mailtoHref = `mailto:${site.email}?subject=${encodeURIComponent("Project inquiry")}`;
const prompts = [
	{
		step: "01",
		title: "Product context",
		description: "What the product does, who it serves, and what is currently blocked or under pressure.",
	},
	{
		step: "02",
		title: "Scope and timeline",
		description: "Whether this is a feature area, a platform problem, a migration, or a delivery gap that needs senior ownership.",
	},
	{
		step: "03",
		title: "Technical constraints",
		description: "Frontend stack, backend contracts, cloud limitations, security requirements, or integration boundaries that matter early.",
	},
	{
		step: "04",
		title: "Outcome",
		description: "What success should look like after the work lands: speed, reliability, maintainability, release confidence, or all of the above.",
	},
];
---

<div class="surface-card-strong grid gap-6 p-5 sm:p-7">
	<div data-reveal>
		<p class="eyebrow">Direct Outreach</p>
		<h2 class="mt-4 text-[clamp(1.9rem,9vw,2.9rem)] leading-[1.03] text-slate-900">
			Lead with the sharp brief, not the polite filler.
		</h2>
		<p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">
			GitHub Pages is static-only, so this contact flow stays intentionally simple: direct email, clear context, and no brittle client-side form plumbing.
		</p>
	</div>

	<ol class="grid gap-4 sm:grid-cols-2">
		{prompts.map((prompt, index) => (
			<li
				class="spotlight-card p-4 sm:p-5"
				data-reveal
				style={`--reveal-delay: ${index * 70}ms;`}
			>
				<p class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-slate-500">
					{prompt.step}
				</p>
				<h3 class="mt-3 text-base font-semibold text-slate-900">{prompt.title}</h3>
				<p class="mt-2 text-sm leading-7 text-slate-600">{prompt.description}</p>
			</li>
		))}
	</ol>

	<div class="rounded-[20px] border border-slate-900/8 bg-slate-900 p-5 text-white sm:rounded-[24px]" data-reveal style="--reveal-delay: 180ms;">
		<p class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-white/70">Fastest path</p>
		<p class="mt-3 text-sm leading-7 text-white/82">
			Email the product context, team shape, expected timeline, and the part of the system that needs senior attention.
		</p>

		<div class="mt-5 flex flex-wrap gap-3">
			<a href={mailtoHref} class="secondary-button border-white/15 bg-white/10 text-white hover:bg-white/16">
				Email directly
			</a>
			<a
				href={site.social.linkedin}
				target="_blank"
				rel="noreferrer"
				class="secondary-button border-white/15 bg-white/10 text-white hover:bg-white/16"
			>
				LinkedIn
			</a>
		</div>

		<p class="mt-5 text-sm text-white/68">
			Primary inbox:
			<a href={`mailto:${site.email}`} class="ml-1 font-semibold text-white hover:text-white/88">
				{site.email}
			</a>
		</p>
	</div>
</div>
