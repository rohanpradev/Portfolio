---
import { site, withBasePath } from "../data/meta";
---

<footer class="pt-10 sm:pt-14">
  <div class="section-shell">
    <div class="surface-card-strong grid gap-8 px-6 py-8 sm:px-8 lg:grid-cols-[1.1fr_auto_auto] lg:items-end">
      <div>
        <p class="eyebrow">Build Something Durable</p>
        <h2 class="mt-4 max-w-lg text-3xl font-semibold text-slate-900 sm:text-4xl">
          Senior product engineering with a bias for clarity, speed, and release confidence.
        </h2>
      </div>

      <div class="text-sm text-slate-600">
        <p class="font-semibold uppercase tracking-[0.22em] text-slate-500">Location</p>
        <p class="mt-2 text-base text-slate-900">{site.location}</p>
        <a class="mt-3 inline-flex text-base font-semibold text-accent hover:text-primary" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </div>

      <div class="grid gap-3 text-sm font-semibold">
        <div class="flex flex-wrap items-center gap-3">
          <a href={site.social.github} target="_blank" rel="noreferrer" class="secondary-button px-4 py-2.5">GitHub</a>
          <a href={site.social.linkedin} target="_blank" rel="noreferrer" class="secondary-button px-4 py-2.5">LinkedIn</a>
        </div>
        <a href={withBasePath("/projects")} class="text-slate-700 transition hover:text-slate-900">View flagship case study</a>
      </div>
    </div>

    <div class="flex flex-col gap-3 px-2 py-6 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} {site.author}. All rights reserved.</p>
      <div class="flex flex-wrap gap-4">
        <a href={withBasePath("/resume")} class="font-medium text-slate-700 hover:text-slate-900">Resume</a>
        <a href={withBasePath("/about")} class="font-medium text-slate-700 hover:text-slate-900">About</a>
        <a href={withBasePath("/contact")} class="font-medium text-slate-700 hover:text-slate-900">Contact</a>
      </div>
    </div>
  </div>
</footer>
