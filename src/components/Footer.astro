---
import { site, withBasePath } from "../data/meta";
---

<footer class="section-shell footer-space border-t border-line pb-12 pt-16">
  <div class="grid gap-12 lg:grid-cols-2">
    <div>
      <a href={withBasePath("/")} class="flex items-center gap-3">
        <img
          src={withBasePath("/brand-mark.svg")}
          alt=""
          width="32"
          height="32"
          class="h-8 w-8"
          loading="lazy"
          decoding="async"
        />
        <span class="text-xl font-bold tracking-tight text-slate-900">{site.author}</span>
      </a>
      <p class="mt-6 max-w-sm text-base leading-relaxed text-slate-500">
        Senior full-stack engineer specialized in high-context product surfaces and AI-enabled systems.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-900">Navigation</h3>
        <ul class="mt-4 space-y-3">
          {site.nav.map(item => (
            <li><a href={item.href} class="text-sm font-medium text-slate-500 hover:text-accent">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-900">Contact</h3>
        <ul class="mt-4 space-y-3 text-sm font-medium text-slate-500">
          <li><a href={`mailto:${site.email}`} class="hover:text-accent">Email</a></li>
          <li><a href={site.social.linkedin} class="hover:text-accent">LinkedIn</a></li>
          <li><a href={site.social.github} class="hover:text-accent">GitHub</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="mt-16 border-t border-line pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-bold text-slate-400 uppercase tracking-widest">
    <p>&copy; {new Date().getFullYear()} {site.author}</p>
    <p>Built with Astro & Tailwind</p>
  </div>
</footer>
