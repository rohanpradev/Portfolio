---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

interface Stat {
	value: string;
	label: string;
}

interface InsightCard {
	label: string;
	title: string;
	detail: string;
}

interface Props {
	title: string;
	headline: string;
	subtitle: string;
	ctaText: string;
	ctaHref: string;
	photo: ImageMetadata;
	photoAlt?: string;
	status?: string;
	location?: string;
	email?: string;
	stats?: Stat[];
	insightCards?: InsightCard[];
}

const {
	title,
	headline,
	subtitle,
	ctaText,
	ctaHref,
	photo,
	photoAlt = "Profile portrait",
	status = "Available for high-impact roles",
	location,
	email,
	stats = [],
	insightCards = [],
} = Astro.props as Props;

const insight = insightCards[0];
---

<section class="section-shell hero-space" aria-labelledby="hero-heading">
	<div class="hero-grid">
		<div class="hero-copy" data-reveal>
			<a href="#contact" class="announcement-pill">
				<span class="status-dot" aria-hidden="true"></span>
				<span>{status}</span>
				<svg aria-hidden="true" focusable="false" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
				</svg>
			</a>

			<p class="hero-identity mt-8 flex items-center gap-3 text-sm font-semibold text-slate-600 sm:mt-10">
				<span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-accent">{title}</span>
				<span aria-hidden="true" class="h-px w-10 bg-current opacity-30"></span>
				<span>Lead full-stack engineer</span>
			</p>

			<h1 id="hero-heading" class="hero-title mt-5">
				{headline}
			</h1>
			<p class="hero-subtitle mt-7 sm:mt-8">{subtitle}</p>

			<div class="mt-8 flex flex-wrap gap-3 sm:mt-10">
				<a href={ctaHref} class="primary-button group">
					{ctaText}
					<svg aria-hidden="true" focusable="false" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
					</svg>
				</a>
				{email && (
					<a href={`mailto:${email}`} class="secondary-button">
						<Icon name="mail" class="h-4 w-4" />
						Email directly
					</a>
				)}
			</div>

			{stats.length > 0 && (
				<dl class="hero-stats">
					{stats.map((stat) => (
						<div>
							<dt>{stat.label}</dt>
							<dd>{stat.value}</dd>
						</div>
					))}
				</dl>
			)}
		</div>

		<div class="hero-visual" data-reveal style="--reveal-delay: 120ms;">
			<figure class="portrait-shell">
				<div class="portrait-grid" aria-hidden="true"></div>
				<Image
					src={photo}
					alt={photoAlt}
					widths={[400, 720, 900]}
					sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1100px) 42vw, 440px"
					format="webp"
					quality={88}
					class="portrait-image"
					priority
				/>
				{location && (
					<figcaption class="portrait-location">
						<Icon name="map-pin" class="h-4 w-4 text-accent" />
						<span>Based in {location}</span>
					</figcaption>
				)}
			</figure>

			{insight && (
				<aside class="hero-insight" aria-label={insight.label}>
					<p class="micro-label">{insight.label}</p>
					<p class="mt-3 text-lg font-semibold leading-snug text-slate-900">{insight.title}</p>
					<p class="mt-2 text-sm leading-6 text-slate-500">{insight.detail}</p>
				</aside>
			)}
		</div>
	</div>
</section>
