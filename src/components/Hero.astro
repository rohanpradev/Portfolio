---
import { Image } from "astro:assets";
import photo from "../assets/profile/profile-photo.webp";
import { withBasePath } from "../data/meta";
---

<section class="section-shell hero-space" aria-labelledby="hero-heading">
  <div class="hero-topline">
    <p class="micro-label">Independent thinking. End-to-end engineering.</p>
    <a class="availability" href={withBasePath("/contact")}>
      <span class="status-dot" aria-hidden="true"></span> Open to the right
      opportunity <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="hero-hello">
        Hi, I’m Rohan <span aria-hidden="true">—</span>
      </p>
      <h1 id="hero-heading" class="hero-title">
        <span>Complex systems.</span>
        <br />
        <span class="hero-serif">Clear experiences.</span>
      </h1>
      <div class="hero-bottomline">
        <p class="hero-subtitle">
          Lead full-stack engineer connecting thoughtful interfaces, dependable
          services, and AI agents that get work done.
        </p>
        <a href="#work" class="primary-button">
          Explore my work <span aria-hidden="true">↘</span>
        </a>
      </div>
    </div>
    <figure class="hero-portrait">
      <div class="portrait-corner" aria-hidden="true">
        RP / 01
      </div>
      <Image
        fit="contain"
        src={photo}
        alt="M Rohan Pradev"
        widths={[320, 480, 640]}
        sizes="(max-width: 639px) 160px, (max-width: 959px) 220px, 280px"
        format="webp"
        quality={85}
        priority
      />
      <figcaption>
        <span>Based in Bengaluru, India</span>
        <span aria-hidden="true">↗</span>
      </figcaption>
    </figure>
  </div>
  <div class="hero-footnote">
    <span>
      <strong>9+ years</strong> building for real-world complexity
    </span>
    <span>
      Currently leading full-stack & AI at <strong>Optum</strong>
    </span>
    <a href={withBasePath("/about")} class="text-link">
      A little about me <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
<style>
  .hero-space {
    padding-top: 9.5rem;
  }
  .hero-topline,
  .hero-footnote {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .hero-topline {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.75rem;
    min-height: 2.75rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 2.5rem;
    align-items: center;
    padding-block: 3.5rem;
  }
  .hero-copy {
    min-width: 0;
  }
  .hero-hello {
    font-size: 1.05rem;
    margin-bottom: 1.3rem;
    color: var(--text-600);
  }
  .hero-title {
    font-size: clamp(3.25rem, 6.1vw, 6.1rem);
    font-weight: 550;
    line-height: 1.03;
    letter-spacing: -0.065em;
    text-wrap: initial;
  }
  .hero-serif {
    color: var(--text-accent);
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.065em;
  }
  .hero-bottomline {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1.7rem;
  }
  .hero-subtitle {
    max-width: 33rem;
    color: var(--text-600);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .hero-portrait {
    position: relative;
    margin: 1rem 0 0;
    transform: rotate(3deg);
    padding: 0.65rem;
    background: var(--surface-strong);
    border: 1px solid var(--line);
    box-shadow: 0 12px 36px -24px #18233366;
    transition: transform 350ms var(--ease-out);
  }
  .hero-portrait:hover {
    transform: rotate(0);
  }
  .hero-portrait img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    filter: saturate(0.65);
  }
  .hero-portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.9rem 0.2rem 0.3rem;
    font-size: 0.62rem;
    font-family: var(--font-mono);
  }
  .portrait-corner {
    position: absolute;
    z-index: 1;
    top: -0.9rem;
    left: 1rem;
    padding: 0.45rem 0.65rem;
    background: var(--primary-fill);
    color: var(--primary-ink);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }
  .hero-footnote {
    border-top: 1px solid var(--line);
    padding-block: 1.3rem;
    color: var(--text-500);
    font-size: 0.75rem;
  }
  .hero-footnote strong {
    color: var(--text-900);
    font-weight: 600;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy {
      animation: entrance 700ms var(--ease-out) both;
    }
    .hero-portrait {
      animation: portrait-in 850ms var(--ease-out) both;
    }
  }
  @keyframes entrance {
    from {
      opacity: 0;
      translate: 0 22px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @keyframes portrait-in {
    from {
      opacity: 0;
      transform: translateY(20px) rotate(-3deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(3deg);
    }
  }
  @media (min-width: 1400px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 4rem;
    }
  }
  @media (max-width: 959px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 190px;
      gap: 1.5rem;
    }
    .hero-title {
      font-size: clamp(2.8rem, 6vw, 4.5rem);
    }
    .hero-footnote {
      flex-wrap: wrap;
    }
    .hero-topline > p {
      max-width: 16rem;
    }
  }
  @media (max-width: 639px) {
    .hero-space {
      padding-top: 6.8rem;
    }
    .hero-topline {
      padding-bottom: 0.8rem;
    }
    .hero-topline > p {
      display: none;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      padding-block: 2rem;
      gap: 2rem;
    }
    .hero-title {
      font-size: clamp(2.45rem, 9.3vw, 3.75rem);
    }
    .hero-hello {
      margin-bottom: 1rem;
    }
    .hero-subtitle {
      font-size: 1rem;
    }
    .hero-portrait {
      width: 160px;
      margin: 0 1rem 0 auto;
    }
    .hero-footnote {
      align-items: start;
      flex-direction: column;
      gap: 0.65rem;
    }
  }
</style>
