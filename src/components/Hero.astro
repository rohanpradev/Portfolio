---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Badge from "./Badge.astro";

interface Stat {
  value: string;
  label: string;
}

interface Highlight {
  title: string;
  detail: string;
}

interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  subtitle: string;
  ctaText: string;
  ctaHref: string;
  resumeHref: string;
  resumeLabel?: string;
  photo: ImageMetadata;
  photoAlt?: string;
  status?: string;
  location?: string;
  email?: string;
  stats?: Stat[];
  highlights?: Highlight[];
  socialLinks?: SocialLink[];
}

const {
  title,
  subtitle,
  ctaText,
  ctaHref,
  resumeHref,
  resumeLabel = "View Resume",
  photo,
  photoAlt = "Profile photo",
  status = "Available for high-impact roles",
  location,
  email,
  stats = [],
  highlights = [],
  socialLinks = [],
} = Astro.props as Props;
---

<section class="section-shell pt-8 sm:pt-10 lg:pt-12">
  <div class="surface-card-strong relative overflow-hidden px-6 py-8 sm:px-8 sm:py-10 lg:px-10 lg:py-12">
    <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(15,118,110,0.18),transparent_34%),radial-gradient(circle_at_bottom_left,_rgba(198,93,24,0.14),transparent_24%)]"></div>
    <div aria-hidden="true" class="absolute right-[-8rem] top-[-8rem] h-64 w-64 rounded-full border border-white/60 bg-white/30 blur-3xl"></div>
    <div aria-hidden="true" class="absolute bottom-[-7rem] left-[-5rem] h-56 w-56 rounded-full bg-accent/10 blur-3xl"></div>

    <div class="relative grid items-center gap-12 lg:grid-cols-[minmax(0,1.02fr)_380px] xl:grid-cols-[minmax(0,1.08fr)_420px]">
      <div>
        <Badge variant="outline" icon="briefcase" class="max-w-[30rem] justify-start text-left leading-6 sm:max-w-[34rem]">
          {status}
        </Badge>
        <h1 class="mt-6 max-w-[11ch] text-[clamp(3.5rem,8vw,6.7rem)] font-semibold leading-[0.93] text-slate-900">
          {title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          {subtitle}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={ctaHref} class="primary-button">{ctaText}</a>
          <a href={resumeHref} class="secondary-button">{resumeLabel}</a>
        </div>

        {(location || email || socialLinks.length > 0) && (
          <div class="mt-8 flex flex-wrap items-center gap-3 text-sm text-slate-600">
            {location && <Badge variant="secondary" icon="map-pin">{location}</Badge>}
            {email && <Badge href={`mailto:${email}`} variant="secondary" icon="mail">{email}</Badge>}
            {socialLinks.map((link) => (
              <Badge
                href={link.href}
                target="_blank"
                rel="noreferrer"
                variant="outline"
                icon={link.label === "GitHub" ? "github" : "linkedin"}
              >
                {link.label}
              </Badge>
            ))}
          </div>
        )}

        {stats.length > 0 && (
          <dl class="mt-10 grid gap-4 sm:grid-cols-3">
            {stats.map((stat) => (
              <div class="surface-card rounded-[22px] px-5 py-4">
                <dt class="text-sm font-medium text-slate-500">{stat.label}</dt>
                <dd class="mt-2 text-3xl font-semibold text-slate-900">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <div class="relative mx-auto w-full max-w-[26rem] space-y-4">
        <div class="surface-card-strong floating-card relative overflow-hidden bg-primary shadow-float">
          <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.14),transparent_38%),radial-gradient(circle_at_top_left,rgba(255,255,255,0.18),transparent_24%)]"></div>
          <Image
            src={photo}
            alt={photoAlt}
            widths={[320, 480, 720]}
            sizes="(max-width: 1024px) min(100vw - 2rem, 26rem), 400px"
            format="webp"
            quality={86}
            class="aspect-square w-full object-cover object-center"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>

        {highlights.length > 0 && (
          <div class="surface-card p-5 text-slate-900 sm:p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-slate-500">What I optimize for</p>
                <p class="mt-2 text-sm leading-6 text-slate-600">Build focus: performance-first product systems.</p>
              </div>
              <div class="hidden border-l-2 border-accent/70 pl-3 sm:block">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-slate-500">Delivery lens</p>
                <p class="mt-1 text-sm leading-6 text-slate-600">Fast, operable systems under real traffic.</p>
              </div>
            </div>

            <ul class="mt-4 space-y-3">
              {highlights.map((item) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-1 h-2.5 w-2.5 rounded-full bg-orange-400"></span>
                  <span>
                    <span class="block text-sm font-semibold text-slate-900">{item.title}</span>
                    <span class="mt-1 block text-sm leading-6 text-slate-600">{item.detail}</span>
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-5 rounded-[18px] bg-slate-900 px-4 py-4 text-sm leading-6 text-white">
              Clear tradeoffs, calm delivery, and interfaces that still feel fast under real traffic.
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
