---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Badge from "./Badge.astro";

interface Stat {
	value: string;
	label: string;
}

interface InsightCard {
	label: string;
	title: string;
	detail: string;
}

interface Props {
	title: string;
	headline: string;
	subtitle: string;
	ctaText: string;
	ctaHref: string;
	photo: ImageMetadata;
	photoAlt?: string;
	status?: string;
	location?: string;
	email?: string;
	stats?: Stat[];
	insightCards?: InsightCard[];
}

const {
	title,
	headline,
	subtitle,
	ctaText,
	ctaHref,
	photo,
	photoAlt = "Profile portrait",
	status = "Available for high-impact roles",
	location,
	email,
	stats = [],
	insightCards = [],
} = Astro.props as Props;

const focusCards = insightCards.slice(0, 2);
---

<section class="section-shell hero-space" aria-labelledby="hero-heading">
	<div class="grid items-start gap-10 lg:grid-cols-[1fr_auto] xl:gap-20">
		<div class="max-w-4xl">
			<div data-reveal>
				<Badge
					variant="outline"
					icon="briefcase"
					class="hero-status-badge mb-7 max-w-fit sm:mb-10"
				>
					{status}
				</Badge>
				<h1
					id="hero-heading"
					class="text-[clamp(3rem,17vw,7rem)] font-black leading-[0.9] tracking-tighter text-slate-900 sm:leading-[0.85]"
				>
					<span class="block text-slate-900">{title.split(' ').slice(0, -1).join(' ')}</span>
					<span class="text-gradient block">{title.split(' ').slice(-1)}</span>
				</h1>
				<p class="mt-7 text-xl font-semibold leading-relaxed text-slate-700 sm:mt-10 sm:text-2xl lg:max-w-3xl">
					{headline}
				</p>
				<p class="mt-4 text-base leading-8 text-slate-500 sm:mt-6 sm:text-xl sm:leading-relaxed lg:max-w-2xl">
					{subtitle}
				</p>
			</div>

			<div class="mt-9 flex flex-wrap gap-3 sm:mt-12 sm:gap-5" data-reveal style="--reveal-delay: 100ms;">
				<a href={ctaHref} class="primary-button group px-10">
					{ctaText}
					<svg class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
					</svg>
				</a>
				{email && (
					<a href={`mailto:${email}`} class="secondary-button px-10">
						Email directly
					</a>
				)}
			</div>

			<div class="mt-10 grid gap-3 sm:mt-16 sm:grid-cols-3 sm:gap-6 lg:max-w-3xl" data-reveal style="--reveal-delay: 200ms;">
				{stats.map((stat) => (
					<div class="hero-stat-card">
						<dt class="text-[0.65rem] font-bold uppercase leading-relaxed tracking-[0.16em] text-slate-500 sm:tracking-[0.2em]">{stat.label}</dt>
						<dd class="mt-2 text-3xl font-black text-slate-900 sm:mt-3 sm:text-4xl">{stat.value}</dd>
					</div>
				))}
			</div>
		</div>

		<div class="relative mx-auto w-full max-w-[360px] md:max-w-[440px] lg:mx-0 lg:max-w-[340px] xl:max-w-[420px]">
			<div class="surface-card-strong group overflow-hidden rounded-[32px] shadow-float " data-reveal style="--reveal-delay: 300ms;">
				<Image
					src={photo}
					alt={photoAlt}
					widths={[400, 800]}
					sizes="(max-width: 640px) calc(100vw - 2rem), 400px"
					format="webp"
					quality={90}
					class="w-full h-auto block transition-all duration-700"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
				<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent p-4 pt-20">
					<div class="inline-flex max-w-full items-center gap-3 rounded-2xl border border-white/20 bg-black/60 px-4 py-3 shadow-panel backdrop-blur-md">
						<div class="h-2.5 w-2.5 shrink-0 animate-pulse rounded-full bg-accent shadow-[0_0_12px_rgba(56,189,248,0.8)]"></div>
						<p class="text-xs font-black uppercase leading-relaxed tracking-[0.18em] text-[#f8fafc]">
							Based in {location}
						</p>
					</div>
				</div>
			</div>

			{focusCards.length > 0 && (
				<div class="mt-5 space-y-4 sm:mt-8 sm:space-y-5" data-reveal style="--reveal-delay: 400ms;">
					{focusCards.map((card, index) => (
						<div class="surface-card p-5 transition-all sm:p-6">
							<p class="text-[0.6rem] font-black uppercase tracking-[0.25em] text-accent">0{index + 1} / {card.label}</p>
							<h3 class="mt-3 text-lg font-bold tracking-tight text-slate-900">{card.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-500">{card.detail}</p>
						</div>
					))}
				</div>
			)}
		</div>
	</div>
</section>


