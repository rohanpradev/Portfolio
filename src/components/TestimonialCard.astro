---
import { Image } from "astro:assets";
import type { Testimonial } from "../data/testimonials";

const { name, role, feedback, avatar, date, context } = Astro.props as Testimonial;
---

<blockquote class="surface-card-strong flex h-full flex-col gap-5 p-6 sm:p-7">
  <div aria-hidden="true" class="text-5xl leading-none text-signal/70">"</div>
  <div class="flex items-start gap-4">
    <Image
      src={avatar}
      alt=""
      widths={[56, 112]}
      sizes="56px"
      width="56"
      height="56"
      class="h-14 w-14 rounded-2xl object-cover ring-1 ring-slate-900/8"
      loading="lazy"
    />

    <div class="min-w-0">
      <p class="text-lg font-semibold text-slate-900">{name}</p>
      <p class="mt-1 text-sm leading-6 text-slate-600">{role}</p>
      <p class="mt-2 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">{date}</p>
    </div>
  </div>

  <p class="text-base leading-8 text-slate-700">
    {feedback}
  </p>

  <footer class="mt-auto border-t border-slate-900/8 pt-4 text-sm text-slate-500">
    {context}
  </footer>
</blockquote>
