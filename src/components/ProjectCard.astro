---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Badge from "./Badge.astro";

interface Outcome {
	value: string;
	label: string;
}

interface Props {
	title: string;
	description: string;
	tech: string[];
	image: ImageMetadata;
	alt: string;
	href?: string;
	company?: string;
	duration?: string;
	outcomes?: Outcome[];
	featured?: boolean;
}

const {
	title,
	description,
	tech,
	image,
	alt,
	href,
	company,
	duration,
	outcomes = [],
	featured = false,
} = Astro.props as Props;

const isLinked = Boolean(href);
const Tag = isLinked ? "a" : "article";
---

<Tag
	{...(isLinked ? { href } : {})}
	class:list={[
		"surface-card-strong flex h-full flex-col overflow-hidden transition duration-300",
		isLinked && "group hover:-translate-y-1.5",
	]}
>
	<div class="relative overflow-hidden">
		<div
			aria-hidden="true"
			class="absolute inset-0 z-10 bg-[linear-gradient(180deg,rgba(15,23,42,0.08),rgba(15,23,42,0.56))]"
		></div>
		<Image
			src={image}
			alt={alt}
			format="webp"
			quality={84}
			widths={[480, 768, 1200]}
			sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 42vw"
			class="h-72 w-full scale-[1.08] object-cover object-center transition duration-700 group-hover:scale-[1.12]"
			loading="lazy"
		/>
		<div class="absolute left-5 top-5 z-20 flex flex-wrap gap-2">
			<Badge variant="accent" icon="sparkles">
				{featured ? "Featured case study" : "Case study"}
			</Badge>
			{company && <Badge variant="dark">{company}</Badge>}
		</div>
		{duration && (
			<div class="absolute bottom-5 left-5 z-20">
				<Badge variant="dark">{duration}</Badge>
			</div>
		)}
	</div>

	<div class="flex flex-1 flex-col gap-5 p-6 sm:p-7">
		<div>
			<h3 class="text-2xl font-semibold text-slate-900 sm:text-[2rem]">{title}</h3>
			{company && <p class="mt-2 text-sm font-medium text-slate-500">{company}</p>}
			<p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{description}</p>
		</div>

		{outcomes.length > 0 && (
			<dl class="grid gap-3 sm:grid-cols-3">
				{outcomes.map((outcome) => (
					<div class="rounded-[18px] border border-slate-900/8 bg-slate-900 px-4 py-4 text-white">
						<dt class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-white/66">
							{outcome.label}
						</dt>
						<dd class="mt-2 text-base font-semibold">{outcome.value}</dd>
					</div>
				))}
			</dl>
		)}

		<div class="flex flex-wrap gap-2">
			{tech.map((item) => <Badge variant="secondary">{item}</Badge>)}
		</div>

		<div class="mt-auto text-sm font-semibold text-slate-900">
			{isLinked ? (
				<div class="inline-flex items-center gap-3">
					<span>Open project details</span>
					<span
						aria-hidden="true"
						class="grid h-8 w-8 place-items-center rounded-full border border-slate-900/10 bg-white/90 transition duration-300 group-hover:translate-x-0.5"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-4 w-4"
						>
							<path d="M7 17 17 7" />
							<path d="M8 7h9v9" />
						</svg>
					</span>
				</div>
			) : (
				<span>Detailed walkthrough available on request.</span>
			)}
		</div>
	</div>
</Tag>
