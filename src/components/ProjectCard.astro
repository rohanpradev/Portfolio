---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Badge from "./Badge.astro";

interface Outcome {
	value: string;
	label: string;
}

interface Props {
	title: string;
	description: string;
	tech: string[];
	image: ImageMetadata;
	alt: string;
	href?: string;
	company?: string;
	duration?: string;
	outcomes?: Outcome[];
	featured?: boolean;
}

const {
	title,
	description,
	tech,
	image,
	alt,
	href,
	company,
	duration,
	outcomes = [],
	featured = false,
} = Astro.props as Props;

const isLinked = Boolean(href);
const Tag = isLinked ? "a" : "article";
---

<Tag
	{...(isLinked ? { href } : {})}
	class:list={[
		"surface-card-strong group flex h-full flex-col overflow-hidden transition-all duration-500",
		isLinked && "hover:-translate-y-2 hover:border-accent/30 hover:shadow-float",
	]}
>
	<div class="relative aspect-video overflow-hidden">
		<Image
			src={image}
			alt={alt}
			format="webp"
			quality={90}
			widths={[480, 768, 1200]}
			sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 42vw"
			class="h-full w-full object-cover object-center transition duration-700 group-hover:scale-110"
			loading="lazy"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>

		<div class="absolute left-6 top-6 flex flex-wrap gap-2">
			{featured && (
				<Badge variant="accent" icon="sparkles" class="shadow-panel backdrop-blur-md">
					Featured
				</Badge>
			)}
			{company && (
				<Badge variant="secondary" class="bg-white/90 text-slate-900 shadow-panel backdrop-blur-md">
					{company}
				</Badge>
			)}
		</div>

		{duration && (
			<div class="absolute bottom-6 left-6">
				<Badge variant="outline" class="border-white/20 bg-black/40 text-white backdrop-blur-md">
					{duration}
				</Badge>
			</div>
		)}
	</div>

	<div class="flex flex-1 flex-col p-8 sm:p-10">
		<div class="mb-6">
			<h3 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
				{title}
			</h3>
			<p class="mt-4 text-lg leading-relaxed text-slate-500 line-clamp-3">
				{description}
			</p>
		</div>

		{outcomes.length > 0 && (
			<dl class="mb-8 grid gap-4 sm:grid-cols-3">
				{outcomes.map((outcome) => (
					<div class="rounded-2xl border border-line bg-surface-tint p-4 transition-colors group-hover:bg-accent/5">
						<dt class="text-[0.6rem] font-bold uppercase tracking-widest text-slate-400">
							{outcome.label}
						</dt>
						<dd class="mt-1 text-base font-bold text-slate-900">{outcome.value}</dd>
					</div>
				))}
			</dl>
		)}

		<div class="mt-auto flex items-center justify-between gap-4">
			<div class="flex flex-wrap gap-1.5">
				{tech.slice(0, 3).map((item) => (
					<span class="text-[0.65rem] font-bold uppercase tracking-wider text-slate-400 bg-slate-900/5 px-2 py-1 rounded-md">
						{item}
					</span>
				))}
				{tech.length > 3 && (
					<span class="text-[0.65rem] font-bold uppercase tracking-wider text-slate-400 bg-slate-900/5 px-2 py-1 rounded-md">
						+{tech.length - 3}
					</span>
				)}
			</div>

			{isLinked && (
				<div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-900 text-white transition-transform group-hover:scale-110">
					<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
					</svg>
				</div>
			)}
		</div>
	</div>
</Tag>
