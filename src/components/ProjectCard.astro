---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Badge from "./Badge.astro";

interface Outcome {
	value: string;
	label: string;
}

interface Props {
	title: string;
	description: string;
	tech: string[];
	image: ImageMetadata;
	alt: string;
	href?: string;
	company?: string;
	duration?: string;
	outcomes?: Outcome[];
	featured?: boolean;
	headingLevel?: "h2" | "h3";
}

const {
	title,
	description,
	tech,
	image,
	alt,
	href,
	company,
	duration,
	outcomes = [],
	featured = false,
	headingLevel = "h3",
} = Astro.props as Props;

const isLinked = Boolean(href);
const Tag = isLinked ? "a" : "article";
---

<Tag
	{...(isLinked ? { href } : {})}
	class:list={[
		"surface-card-strong project-card group flex h-full flex-col overflow-hidden lg:grid lg:grid-cols-[1.12fr_0.88fr]",
		isLinked && "hover:border-accent/30",
	]}
>
	<div class="project-media">
		<div class="project-image-frame">
			<Image
				src={image}
				alt={alt}
				format="webp"
				quality={82}
				widths={[480, 768, 1200]}
				sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 42vw"
				class="block h-auto w-full transition duration-500 group-hover:scale-[1.015]"
				loading="lazy"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-slate-900/25 via-transparent to-transparent"></div>

			<div class="absolute left-3 right-3 top-3 flex flex-wrap gap-2 sm:left-5 sm:right-auto sm:top-5">
				{featured && (
					<Badge variant="accent" icon="sparkles" class="shadow-panel">
						Featured
					</Badge>
				)}
				{company && (
					<Badge variant="secondary" class="bg-white/90 text-slate-900 shadow-panel">
						{company}
					</Badge>
				)}
			</div>
		</div>

		<div class="project-media-rail">
			<span>{duration ?? "Selected case study"}</span>
			<span aria-hidden="true">Product systems / delivery</span>
		</div>
	</div>

	<div class="flex flex-1 flex-col p-6 sm:p-8 lg:px-8 lg:py-6">
		<div class="mb-4">
			{headingLevel === "h2" ? (
				<h2 class="text-2xl font-semibold leading-tight tracking-tight text-slate-900 sm:text-[2rem]">
					{title}
				</h2>
			) : (
				<h3 class="text-2xl font-semibold leading-tight tracking-tight text-slate-900 sm:text-[2rem]">
					{title}
				</h3>
			)}
			<p class="mt-3 line-clamp-3 text-base leading-7 text-slate-500 sm:line-clamp-2">
				{description}
			</p>
		</div>

		{outcomes.length > 0 && (
			<dl class="project-outcomes mb-5 grid grid-cols-3">
				{outcomes.map((outcome) => (
					<div>
						<dt class="text-[0.6rem] font-bold uppercase leading-relaxed tracking-widest text-slate-400">
							{outcome.label}
						</dt>
						<dd class="mt-1 text-base font-bold text-slate-900">{outcome.value}</dd>
					</div>
				))}
			</dl>
		)}

		<div class="mt-auto flex items-end justify-between gap-4">
			<div class="flex flex-wrap gap-1.5">
				{tech.slice(0, 3).map((item) => (
					<span class="text-[0.65rem] font-bold uppercase tracking-wider text-slate-400 bg-slate-900/5 px-2 py-1 rounded-md">
						{item}
					</span>
				))}
				{tech.length > 3 && (
					<span class="text-[0.65rem] font-bold uppercase tracking-wider text-slate-400 bg-slate-900/5 px-2 py-1 rounded-md">
						+{tech.length - 3}
					</span>
				)}
			</div>

			{isLinked && (
				<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-900 text-white transition-transform group-hover:scale-110">
					<svg aria-hidden="true" focusable="false" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
					</svg>
				</div>
			)}
		</div>
	</div>
</Tag>
