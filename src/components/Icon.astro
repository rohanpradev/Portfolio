---
type IconName =
  | "briefcase"
  | "calendar"
  | "check"
  | "github"
  | "layers"
  | "linkedin"
  | "mail"
  | "map-pin"
  | "sparkles";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "h-4 w-4" } = Astro.props as Props;

const paths: Record<IconName, string> = {
  briefcase:
    '<path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7" /><path d="M4.75 8h14.5A1.75 1.75 0 0 1 21 9.75v7.5A1.75 1.75 0 0 1 19.25 19h-14.5A1.75 1.75 0 0 1 3 17.25v-7.5A1.75 1.75 0 0 1 4.75 8Z" /><path d="M3 12.5h18" />',
  calendar:
    '<path d="M7 3v3" /><path d="M17 3v3" /><path d="M4.75 6h14.5A1.75 1.75 0 0 1 21 7.75v11.5A1.75 1.75 0 0 1 19.25 21H4.75A1.75 1.75 0 0 1 3 19.25V7.75A1.75 1.75 0 0 1 4.75 6Z" /><path d="M3 10.5h18" />',
  check:
    '<path d="M20 6 9 17l-5-5" />',
  github:
    '<path d="M9 19c-4.5 1.4-4.5-2.5-6-3" /><path d="M15 21v-3.5a3 3 0 0 0-.9-2.3c3-.3 6.2-1.5 6.2-6.7A5.2 5.2 0 0 0 19 4.8 4.8 4.8 0 0 0 18.9 1S17.8.7 15 2.5a13 13 0 0 0-6 0C6.2.7 5.1 1 5.1 1A4.8 4.8 0 0 0 5 4.8a5.2 5.2 0 0 0-1.3 3.7c0 5.2 3.2 6.4 6.2 6.7a3 3 0 0 0-.9 2.3V21" />',
  layers:
    '<path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z" /><path d="m4 12 8 4.5 8-4.5" /><path d="m4 16.5 8 4.5 8-4.5" />',
  linkedin:
    '<path d="M7 8v9" /><path d="M7 4.5v.5" /><path d="M12 17v-5.2a2.8 2.8 0 0 1 5.5 0V17" /><path d="M12 12a2.8 2.8 0 0 1 5.5 0" /><rect x="3" y="3" width="18" height="18" rx="3" />',
  mail:
    '<path d="M4.75 6h14.5A1.75 1.75 0 0 1 21 7.75v8.5A1.75 1.75 0 0 1 19.25 18H4.75A1.75 1.75 0 0 1 3 16.25v-8.5A1.75 1.75 0 0 1 4.75 6Z" /><path d="m4 8 8 5 8-5" />',
  "map-pin":
    '<path d="M12 21s6-5.5 6-11a6 6 0 1 0-12 0c0 5.5 6 11 6 11Z" /><circle cx="12" cy="10" r="2.25" />',
  sparkles:
    '<path d="M12 3 13.75 8.25 19 10l-5.25 1.75L12 17l-1.75-5.25L5 10l5.25-1.75L12 3Z" /><path d="M18.5 3.5v3" /><path d="M20 5h-3" /><path d="M5.5 16.5v3" /><path d="M7 18h-3" />',
};
---

<svg
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={paths[name]}
/>
