---
import { experiences } from "../data/experiences";
import CognizantLogoUrl from "../assets/logos/cognizant.svg?url";
import EricssonLogoUrl from "../assets/logos/ericsson.svg?url";
import MindtreeLogoUrl from "../assets/logos/mindtree.svg?url";
import TechmLogoUrl from "../assets/logos/techm.svg?url";

const companies = experiences.map((experience) => ({
  name: experience.company,
  logo: experience.logo,
}));

const logos = {
  cognizant: CognizantLogoUrl,
  ericsson: EricssonLogoUrl,
  mindtree: MindtreeLogoUrl,
  techm: TechmLogoUrl,
} as const;
---

<section class="py-2 sm:py-10">
  <div class="section-shell">
    <div class="surface-card-strong px-5 py-5 sm:px-6">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-xl">
          <p class="eyebrow">Trusted In Delivery</p>
          <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">
            Experience across enterprise engineering environments, modernization efforts, and product systems where quality has to survive operational pressure.
          </p>
        </div>

        <div class="grid flex-1 grid-cols-2 gap-3 sm:grid-cols-4 lg:max-w-3xl">
          {companies.map((company) => {
            const logoSrc = logos[company.logo];

            return (
              <div class="company-logo-shell grid min-h-[4.75rem] place-items-center rounded-[20px] border border-slate-900/8 bg-white/88 px-3 py-4 sm:min-h-[5.75rem] sm:rounded-[24px] sm:px-4">
                <img
                  src={logoSrc}
                  alt={`${company.name} logo`}
                  width="160"
                  height="48"
                  class="max-h-8 w-full object-contain sm:max-h-9"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
