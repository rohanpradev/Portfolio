---
import { experiences } from "../data/experiences";
import CognizantLogoUrl from "../assets/logos/cognizant.svg?url";
import EricssonLogoUrl from "../assets/logos/ericsson.svg?url";
import MindtreeLogoUrl from "../assets/logos/mindtree.svg?url";
import OptumLogoUrl from "../assets/logos/optum.svg?url";
import TechmLogoUrl from "../assets/logos/techm.svg?url";
const logos = {
  cognizant: CognizantLogoUrl,
  ericsson: EricssonLogoUrl,
  mindtree: MindtreeLogoUrl,
  optum: OptumLogoUrl,
  techm: TechmLogoUrl,
};
---

<section class="section-shell" aria-label="Companies I have worked with">
  <div class="company-proof-strip">
    <p class="micro-label">Experience shaped by teams at</p>
    <div class="company-logos">
      {experiences.map((experience) => (
        <div class="company-logo-shell">
          <img
            src={logos[experience.logo]}
            alt={experience.company}
            width="160"
            height="48"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .company-proof-strip {
    display: flex;
    gap: 3rem;
    align-items: center;
  }
  .company-proof-strip > p {
    max-width: 9rem;
    flex-shrink: 0;
  }
  .company-logos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2.5rem;
    align-items: center;
    flex: 1;
  }
  .company-logo-shell img {
    width: 100%;
    max-height: 35px;
    object-fit: contain;
  }
  @media (max-width: 767px) {
    .company-proof-strip {
      flex-direction: column;
      align-items: start;
      gap: 1.5rem;
    }
    .company-proof-strip > p {
      max-width: none;
    }
    .company-logos {
      width: 100%;
      gap: 1.5rem;
    }
    .company-logo-shell img {
      max-height: 28px;
    }
  }
  @media (max-width: 479px) {
    .company-logos {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem 2rem;
    }
  }
</style>
