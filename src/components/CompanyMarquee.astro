---
import { experiences } from "../data/experiences";
import CognizantLogo from "../assets/logos/cognizant.svg";
import EricssonLogo from "../assets/logos/ericsson.svg";
import MindtreeLogo from "../assets/logos/mindtree.svg";
import TechmLogo from "../assets/logos/techm.svg";

const companies = experiences.map((experience) => ({
  name: experience.company,
  logo: experience.logo,
}));

const logos = {
  cognizant: CognizantLogo,
  ericsson: EricssonLogo,
  mindtree: MindtreeLogo,
  techm: TechmLogo,
} as const;
---

<section class="py-2 sm:py-10">
  <div class="section-shell">
    <div class="surface-card-strong px-5 py-5 sm:px-6">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-xl">
          <p class="eyebrow">Trusted In Delivery</p>
          <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">
            Experience across enterprise engineering environments, modernization efforts, and product systems where quality has to survive operational pressure.
          </p>
        </div>

        <div class="grid flex-1 grid-cols-2 gap-3 sm:grid-cols-4 lg:max-w-3xl">
          {companies.map((company) => {
            const Logo = logos[company.logo];

            return (
              <div class="company-logo-shell grid min-h-[4.75rem] place-items-center rounded-[20px] border border-slate-900/8 bg-white/88 px-3 py-4 sm:min-h-[5.75rem] sm:rounded-[24px] sm:px-4">
                <Logo class="max-h-8 w-full sm:max-h-9" aria-label={`${company.name} logo`} />
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
