---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  as?: "h1" | "h2";
}

const { id, eyebrow, title, description, align = "left", as = "h2" } = Astro.props as Props;
const centered = align === "center";
---

<div class:list={["max-w-3xl", centered && "mx-auto text-center"]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  {as === "h1" ? (
    <h1 id={id} class="section-title mt-5">{title}</h1>
  ) : (
    <h2 id={id} class="section-title mt-5">{title}</h2>
  )}
  {description && <p class="section-copy mt-4">{description}</p>}
</div>
