---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { id, eyebrow, title, description, align = "left" } = Astro.props as Props;
const centered = align === "center";
---

<div class:list={["max-w-3xl", centered && "mx-auto text-center"]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="section-title mt-5">{title}</h2>
  {description && <p class="section-copy mt-4">{description}</p>}
</div>
