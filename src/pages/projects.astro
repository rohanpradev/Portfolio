---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, withBasePath } from "../data/meta";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const structuredData = [
  {
    "@type": "CollectionPage",
    name: "Selected projects",
    hasPart: projects.map((project) => ({
      "@type": "CreativeWork",
      name: project.data.title,
      url: new URL(
        withBasePath(`/projects/${project.id}`),
        site.url,
      ).toString(),
    })),
  },
];
---

<BaseLayout
  title={`Projects | ${site.name}`}
  description="Selected work in enterprise product engineering and applied AI, including Optum reagent optimization with Strands Agents and AWS."
  structuredData={structuredData}
>
  <section class="section-shell intro-space" aria-labelledby="projects-heading">
    <div class="section-intro-row">
      <div>
        <p class="micro-label">
          Selected work / {String(projects.length).padStart(2, "0")} case
          studies
        </p>
        <h1 id="projects-heading" class="editorial-title mt-5">
          Thoughtful engineering.
          <br />
          <span class="serif-text">Useful outcomes.</span>
        </h1>
      </div>
      <p class="section-aside">
        From enterprise interfaces to agents that execute cloud workloads. The
        context, the architecture, and my contribution.
      </p>
    </div>
    <div class="work-list">
      {projects.map((project, index) => (
        <div data-reveal>
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            tech={project.data.tech}
            image={project.data.cover}
            alt={project.data.coverAlt}
            href={withBasePath(`/projects/${project.id}`)}
            company={project.data.company}
            duration={project.data.duration}
            outcomes={project.data.outcomes}
            headingLevel="h2"
            index={index + 1}
          />
        </div>
      ))}
    </div>
    <a href={withBasePath("/contact")} class="primary-button mt-10">
      Discuss similar work <span aria-hidden="true">↗</span>
    </a>
  </section>
</BaseLayout>
