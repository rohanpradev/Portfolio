---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site } from "../data/meta";

const projects = (await getCollection("projects")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
	title={`Projects | ${site.name}`}
	description="Selected project summaries from M Rohan Pradev covering enterprise product delivery, frontend architecture, backend orchestration, and AI-assisted workflows."
>
	<section class="section-shell pt-8 sm:pt-10">
		<div class="surface-card-strong p-8 sm:p-10 lg:p-12">
			<SectionHeading
				eyebrow="Projects"
				title="Project summaries focused on the work that actually proves engineering depth."
				description="This page keeps the strongest project visible without exposing the full detailed walkthrough publicly right now."
			/>
		</div>
	</section>

	<section class="section-shell py-16 sm:py-20 lg:py-24">
		<div class="grid gap-6">
			{projects.map((project) => (
				<ProjectCard
					title={project.data.title}
					description={project.data.description}
					tech={project.data.tech}
					image={project.data.cover}
					alt={project.data.coverAlt}
					company={project.data.company}
					duration={project.data.duration}
					outcomes={project.data.outcomes}
				/>
			))}
		</div>
	</section>
</BaseLayout>
