---
import { getImage, Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, withBasePath } from "../../data/meta";
export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const projectUrl = new URL(
  withBasePath(`/projects/${project.id}`),
  site.url,
).toString();
const socialImage = await getImage({
  src: project.data.cover,
  width: 1200,
  format: "webp",
  quality: 82,
});
const toc = headings.filter((heading) => heading.depth === 2);
const structuredData = [
  {
    "@type": "Article",
    headline: project.data.title,
    description: project.data.description,
    image: new URL(socialImage.src, site.url).toString(),
    datePublished: project.data.publishedDate.toISOString(),
    dateModified: project.data.updatedDate.toISOString(),
    author: { "@id": `${site.homeUrl}#person` },
    mainEntityOfPage: projectUrl,
  },
];
---

<BaseLayout
  title={project.data.seoTitle ?? `${project.data.title} | ${site.name}`}
  description={project.data.seoDescription ?? project.data.description}
  image={project.data.cover}
  imageAlt={project.data.coverAlt}
  structuredData={structuredData}
  publishedTime={project.data.publishedDate.toISOString()}
  modifiedTime={project.data.updatedDate.toISOString()}
  openGraphType="article"
>
  <article class="section-shell intro-space">
    <a href={withBasePath("/projects")} class="text-link">
      ← All projects
    </a>
    <header class="case-header">
      <p class="micro-label">
        {project.data.company ?? "Enterprise engineering"} / Case study
      </p>
      <h1>{project.data.title}</h1>
      <p class="case-description">{project.data.description}</p>
      <dl class="case-facts">
        <div>
          <dt>My role</dt>
          <dd>{project.data.role}</dd>
        </div>
        <div>
          <dt>Engagement</dt>
          <dd>{project.data.duration}</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>{project.data.services.slice(0, 2).join(" / ")}</dd>
        </div>
      </dl>
    </header>
    <figure class="case-cover">
      <Image
        fit="contain"
        src={project.data.cover}
        alt={project.data.coverAlt}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 767px) calc(100vw - 2.5rem), (max-width: 1380px) 90vw, 1252px"
        format="webp"
        quality={85}
        priority
      />
      {project.data.gallery[0]?.caption && (
        <figcaption>{project.data.gallery[0].caption}</figcaption>
      )}
    </figure>
    <div class="case-body">
      <div class="case-study-prose">
        <Content />
      </div>
      <aside>
        <nav aria-label="On this page">
          <p class="micro-label">In this case study</p>
          <ol>
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
        <div class="case-stack">
          <p class="micro-label">Tools & technologies</p>
          <ul>
            {project.data.tech.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        </div>
        <a href={withBasePath("/contact")} class="text-link">
          Discuss similar work ↗
        </a>
      </aside>
    </div>
    <div class="case-next">
      <p class="micro-label">Have a similar challenge?</p>
      <h2>
        Let’s put experience
        <br />
        <span class="serif-text">to work.</span>
      </h2>
      <div class="flex flex-wrap gap-3 mt-6">
        <a href={withBasePath("/contact")} class="primary-button">
          Start a conversation ↗
        </a>
        <a href={withBasePath("/projects")} class="secondary-button">
          More work
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
<style>
  .case-header {
    margin-top: 2rem;
  }
  .case-header h1 {
    font-size: clamp(2.5rem, 5.5vw, 5rem);
    max-width: 23ch;
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.04;
    margin-top: 1.5rem;
  }
  .case-description {
    max-width: 49rem;
    color: var(--text-600);
    font-size: 1.1rem;
    line-height: 1.85;
    margin-top: 1.5rem;
  }
  .case-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-block: 2.5rem;
    border-block: 1px solid var(--line);
    padding-block: 1.5rem;
  }
  .case-facts dt {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    color: var(--text-500);
    letter-spacing: 0.12em;
  }
  .case-facts dd {
    font-size: 0.85rem;
    line-height: 1.7;
    margin-top: 0.65rem;
  }
  .case-cover {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
  }
  .case-cover img {
    width: 100%;
    max-height: 680px;
    object-fit: contain;
  }
  .case-cover figcaption {
    border-top: 1px solid var(--line);
    padding: 1rem 1.3rem;
    color: var(--text-500);
    font-size: 0.75rem;
    line-height: 1.7;
  }
  .case-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: clamp(2rem, 7vw, 6rem);
    margin-top: 4rem;
    align-items: start;
  }
  .case-body aside {
    position: sticky;
    top: 7rem;
    padding-top: 1rem;
  }
  .case-body nav ol {
    list-style: none;
    margin: 1rem 0 2rem;
    padding: 0;
  }
  .case-body nav a {
    display: block;
    padding: 0.5rem 0;
    font-size: 0.8rem;
    color: var(--text-600);
    line-height: 1.7;
  }
  .case-body nav a:hover {
    color: var(--text-accent);
  }
  .case-stack {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .case-stack ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .case-stack li {
    font-size: 0.62rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--text-600);
  }
  .case-next {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line);
  }
  .case-next h2 {
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    line-height: 1.1;
    margin-top: 1rem;
  }
  @media (max-width: 767px) {
    .case-body {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }
    .case-body aside {
      position: static;
      grid-row: 1;
    }
    .case-body nav ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      margin-bottom: 1rem;
    }
    .case-stack {
      display: none;
    }
    .case-body aside > .text-link {
      display: none;
    }
    .case-facts {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .case-facts > div {
      display: grid;
      grid-template-columns: 6rem 1fr;
      gap: 1rem;
    }
    .case-facts dd {
      margin-top: 0;
    }
    .case-description {
      font-size: 1rem;
    }
  }
</style>
