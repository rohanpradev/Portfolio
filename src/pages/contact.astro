---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site } from "../data/meta";

const contactReasons = [
  {
    title: "Enterprise application delivery",
    description: "Own a feature area, module, or application surface that needs senior full-stack execution.",
  },
  {
    title: "Frontend architecture and reviews",
    description: "Improve component systems, data loading patterns, PR quality, and maintainable UI foundations.",
  },
  {
    title: "Secure API integration",
    description: "Design auth flows, RBAC boundaries, and API contracts that teams can confidently build on.",
  },
  {
    title: "AI and retrieval workflows",
    description: "Add OpenAI or RAG capabilities with production-minded engineering rather than prototype-only thinking.",
  },
];
---

<BaseLayout title={`Contact | ${site.name}`} description="Contact M Rohan Pradev for senior full-stack engineering, frontend architecture, and AI-enabled product work.">
  <section id="contact-form" class="section-shell pt-8 sm:pt-10">
    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div class="surface-card-strong p-8 sm:p-10">
        <SectionHeading
          eyebrow="Contact"
          title="Start with the product problem, not a generic intro."
          description="This form now posts to a real server endpoint backed by Postmark. It is rendered as a deferred server island so the contact workflow stays dynamic without forcing the whole page to become heavy."
        />

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {contactReasons.map((reason) => (
            <article class="rounded-[20px] border border-slate-900/8 bg-white/80 p-5">
              <h2 class="text-lg font-semibold text-slate-900">{reason.title}</h2>
              <p class="mt-2 text-sm leading-7 text-slate-600">{reason.description}</p>
            </article>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="primary-button" href={`mailto:${site.email}`}>Email directly</a>
          <a class="secondary-button" href={site.social.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        </div>

        <div class="mt-8 rounded-[20px] border border-slate-900/8 bg-white/80 p-5 text-sm text-slate-600">
          <p class="font-semibold uppercase tracking-[0.2em] text-slate-500">Based in</p>
          <p class="mt-2 text-base text-slate-900">{site.location}</p>
          <p class="mt-3">Primary contact path: <a class="font-semibold text-accent hover:text-primary" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </div>

      <ContactForm server:defer redirectTo="/contact#contact-form">
        <div slot="fallback" class="surface-card-strong grid gap-4 p-6 sm:p-7">
          <p class="eyebrow">Loading</p>
          <h3 class="text-2xl font-semibold text-slate-900">Preparing the secure contact form.</h3>
          <p class="text-sm leading-7 text-slate-600">The mail endpoint is deferred so the page can render immediately.</p>
        </div>
      </ContactForm>
    </div>
  </section>
</BaseLayout>
