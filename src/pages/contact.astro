---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site, withBasePath } from "../data/meta";

const contactReasons = [
	{
		title: "Enterprise application delivery",
		description: "Own a feature area, module, or application surface that needs senior full-stack execution.",
	},
	{
		title: "Frontend architecture and reviews",
		description: "Improve component systems, data loading patterns, PR quality, and maintainable UI foundations.",
	},
	{
		title: "Secure API integration",
		description: "Design auth flows, RBAC boundaries, and API contracts that teams can confidently build on.",
	},
	{
		title: "AI and retrieval workflows",
		description: "Add OpenAI or RAG capabilities with production-minded engineering rather than prototype-only thinking.",
	},
];

const contactHighlights = [
	{ label: "Primary route", value: site.email },
	{ label: "Location", value: site.location },
	{ label: "Best fit", value: "Senior product engineering, frontend systems, integration design, and AI-assisted workflows" },
];

const contactPageUrl = new URL(withBasePath("/contact"), site.url).toString();
const structuredData = [
	{
		"@type": "ContactPage",
		"@id": `${contactPageUrl}#contact-page`,
		url: contactPageUrl,
		name: `Contact ${site.name}`,
		description:
			"Contact M Rohan Pradev for senior full-stack engineering, frontend architecture, and AI-enabled product work.",
		mainEntity: {
			"@id": `${site.homeUrl}#person`,
		},
	},
	{
		"@type": "ContactPoint",
		"@id": `${contactPageUrl}#contact-point`,
		email: site.email,
		contactType: "business inquiries",
		availableLanguage: ["English"],
		areaServed: "Worldwide",
	},
];
---

<BaseLayout
	title={`Contact | ${site.name}`}
	description="Contact M Rohan Pradev for senior full-stack engineering, frontend architecture, and AI-enabled product work."
	structuredData={structuredData}
>
	<section id="contact-intro" aria-labelledby="contact-heading" class="section-shell intro-space">
		<div class="surface-card-strong grid gap-8 p-8 sm:p-10 lg:grid-cols-[0.94fr_1.06fr] lg:items-start">
			<div data-reveal>
				<SectionHeading
					id="contact-heading"
					eyebrow="Contact"
					title="Start with the product problem, not a generic intro."
					description="This page keeps outreach direct and static for GitHub Pages. The fastest path is a short project brief over email with enough context to make the first reply useful."
				/>

				<div class="mt-8 flex flex-wrap gap-3">
					<a class="primary-button" href={`mailto:${site.email}`}>Email directly</a>
					<a class="secondary-button" href={site.social.linkedin} target="_blank" rel="noreferrer">
						LinkedIn
					</a>
					<a class="secondary-button" href={withBasePath("/projects")}>View case study</a>
				</div>
			</div>

			<div class="grid gap-4">
				{contactHighlights.map((item, index) => (
					<div
						class="surface-card p-5"
						data-reveal
						style={`--reveal-delay: ${index * 80}ms;`}
					>
						<p class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-slate-500">
							{item.label}
						</p>
						<p class="mt-3 text-lg font-semibold text-slate-900">{item.value}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="contact-fit" aria-labelledby="fit-heading" class="section-shell">
		<div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
			<div class="surface-card-strong p-8 sm:p-10">
				<div data-reveal>
					<SectionHeading
						id="fit-heading"
						eyebrow="Best Fit"
						title="When reaching out makes sense."
						description="The strongest fit is work that needs senior ownership across the interface, the integration layer, and the engineering quality bar."
					/>
				</div>

				<div class="mt-8 grid gap-4 sm:grid-cols-2">
					{contactReasons.map((reason, index) => (
						<article
							class="rounded-[20px] border border-slate-900/8 bg-white/80 p-5"
							data-reveal
							style={`--reveal-delay: ${index * 70}ms;`}
						>
							<h2 class="text-lg font-semibold text-slate-900">{reason.title}</h2>
							<p class="mt-2 text-sm leading-7 text-slate-600">{reason.description}</p>
						</article>
					))}
				</div>
			</div>

			<ContactForm />
		</div>
	</section>

	<section class="section-shell">
		<div class="surface-card-strong grid gap-6 p-8 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-end" data-reveal>
			<div>
				<p class="eyebrow">Response style</p>
				<h2 class="mt-4 max-w-[14ch] text-[clamp(2.2rem,4vw,3.4rem)] font-semibold leading-[1.02] text-slate-900">
					Clear first response, concrete next step, no long back-and-forth before the real discussion.
				</h2>
				<p class="mt-4 max-w-2xl text-base leading-8 text-slate-600">
					If the brief includes the current constraint, stack, and delivery goal, the first reply can usually focus on tradeoffs and fit instead of clarification loops.
				</p>
			</div>

			<div class="flex flex-col gap-3">
				<a href={`mailto:${site.email}`} class="primary-button">Email {site.author}</a>
				<a href={site.social.linkedin} target="_blank" rel="noreferrer" class="secondary-button">
					LinkedIn message
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
