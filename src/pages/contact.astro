---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { site, withBasePath } from "../data/meta";
const pageUrl = new URL(withBasePath("/contact"), site.url).toString();
---

<BaseLayout
  title={`Contact | ${site.name}`}
  description="Get in touch with M Rohan Pradev for full-stack leadership, frontend architecture, and applied AI engineering."
  structuredData={[
    {
      "@type": "ContactPage",
      url: pageUrl,
      name: `Contact ${site.name}`,
      mainEntity: { "@id": `${site.homeUrl}#person` },
    },
  ]}
>
  <section class="section-shell intro-space" aria-labelledby="contact-heading">
    <p class="micro-label">Let’s connect</p>
    <h1 id="contact-heading" class="editorial-title mt-5">
      Something in mind?
      <br />
      <span class="serif-text">Let’s talk.</span>
    </h1>
    <div class="contact-grid">
      <div>
        <p class="contact-intro">
          I’m open to lead full-stack, frontend architecture, and AI product
          roles where thoughtful engineering makes a difference.
        </p>
        <dl class="contact-facts">
          <div>
            <dt>Based in</dt>
            <dd>{site.location}</dd>
          </div>
          <div>
            <dt>Currently</dt>
            <dd>Lead Full Stack Engineer at Optum</dd>
          </div>
          <div>
            <dt>Interested in</dt>
            <dd>
              Product engineering, agent workflows, and teams that care about
              craft.
            </dd>
          </div>
        </dl>
        <div class="flex flex-wrap gap-6">
          <a
            href={site.social.linkedin}
            target="_blank"
            rel="noreferrer"
            class="text-link"
          >
            LinkedIn ↗
          </a>
          <a
            href={site.social.github}
            target="_blank"
            rel="noreferrer"
            class="text-link"
          >
            GitHub ↗
          </a>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 7vw, 6rem);
    margin-top: 3.5rem;
    align-items: start;
  }
  .contact-intro {
    font-size: 1.15rem;
    color: var(--text-600);
    line-height: 1.8;
    max-width: 29rem;
  }
  .contact-facts {
    margin-block: 2rem;
  }
  .contact-facts > div {
    padding-block: 1.2rem;
    border-top: 1px solid var(--line);
  }
  .contact-facts dt {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-500);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .contact-facts dd {
    font-size: 0.95rem;
    line-height: 1.8;
    margin-top: 0.5rem;
  }
  @media (max-width: 767px) {
    .contact-grid {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }
  }
</style>
