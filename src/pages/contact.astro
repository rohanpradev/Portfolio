---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site, withBasePath } from "../data/meta";

const contactReasons = [
	{
		title: "Application Delivery",
		description: "Own a feature area or module that needs senior full-stack execution.",
	},
	{
		title: "Frontend Systems",
		description: "Improve component systems, PR quality, and maintainable UI foundations.",
	},
	{
		title: "Secure Integration",
		description: "Design auth flows and API contracts that teams can confidently build on.",
	},
	{
		title: "AI Workflows",
		description: "Add OpenAI or RAG capabilities with production-minded engineering.",
	},
];

const contactHighlights = [
	{ label: "Primary Route", value: site.email },
	{ label: "Current Location", value: site.location },
];

const contactPageUrl = new URL(withBasePath("/contact"), site.url).toString();
const structuredData = [
	{
		"@type": "ContactPage",
		"@id": `${contactPageUrl}#contact-page`,
		url: contactPageUrl,
		name: `Contact ${site.name}`,
		description:
			"Contact M Rohan Pradev for senior full-stack engineering, frontend architecture, and AI-enabled product work.",
		mainEntity: {
			"@id": `${site.homeUrl}#person`,
		},
	},
	{
		"@type": "ContactPoint",
		"@id": `${contactPageUrl}#contact-point`,
		email: site.email,
		contactType: "business inquiries",
		availableLanguage: ["English"],
		areaServed: "Worldwide",
	},
];
---

<BaseLayout
	title={`Contact | ${site.name}`}
	description="Contact M Rohan Pradev for senior full-stack engineering, frontend architecture, and AI-enabled product work."
	structuredData={structuredData}
>
	<section id="contact-intro" aria-labelledby="contact-heading" class="section-shell intro-space">
		<div class="surface-card-strong grid gap-16 p-10 sm:p-16 lg:p-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
			<div data-reveal>
				<SectionHeading
					id="contact-heading"
					as="h1"
					eyebrow="Contact"
					title="Start with the problem statement."
					description="The fastest path is a short project brief with enough context to make the first reply useful."
				/>

				<div class="mt-12 flex flex-wrap gap-5">
					<a class="primary-button group px-10" href={`mailto:${site.email}`}>
						Email Directly
						<svg aria-hidden="true" focusable="false" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
						</svg>
					</a>
					<a class="secondary-button px-10" href={site.social.linkedin} target="_blank" rel="noreferrer">
						LinkedIn
					</a>
				</div>
			</div>

			<div class="grid gap-6">
				{contactHighlights.map((item, index) => (
					<div
						class="surface-card bg-surface-tint border-none p-8"
						data-reveal
						style={`--reveal-delay: ${index * 80}ms;`}
					>
						<p class="text-[0.65rem] font-bold uppercase tracking-widest text-slate-500">
							{item.label}
						</p>
						<p class="mt-2 text-2xl font-black text-slate-900 leading-none">{item.value}</p>
					</div>
				))}
				<div class="rounded-[40px] bg-slate-900 p-10 text-white shadow-float" data-reveal style="--reveal-delay: 160ms;">
					<p class="text-[0.7rem] font-black uppercase tracking-[0.3em] text-accent">Best Fit</p>
					<p class="mt-6 text-xl font-bold leading-relaxed">
						Senior product engineering where technical ownership and delivery rigor are non-negotiable.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section id="contact-fit" aria-labelledby="fit-heading" class="section-shell">
		<div class="grid gap-16 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
			<div class="space-y-16">
				<SectionHeading
					id="fit-heading"
					eyebrow="Capabilities"
					title="Areas of focus."
					description="Ownership across the interface, the integration layer, and the engineering quality bar."
				/>

				<div class="grid gap-6 sm:grid-cols-2">
					{contactReasons.map((reason, index) => (
						<article
							class="surface-card p-8 transition-all hover:border-accent/40"
							data-reveal
							style={`--reveal-delay: ${index * 70}ms;`}
						>
							<h3 class="text-xl font-black text-slate-900 tracking-tight leading-tight">{reason.title}</h3>
							<p class="mt-4 text-base leading-relaxed text-slate-500 font-medium">{reason.description}</p>
						</article>
					))}
				</div>
			</div>

			<div class="surface-card p-1 shadow-float">
				<ContactForm />
			</div>
		</div>
	</section>
</BaseLayout>
