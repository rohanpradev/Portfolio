---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBasePath } from "../data/meta";
---

<BaseLayout title="Page not found | M Rohan Pradev" noindex>
  <section class="section-shell intro-space">
    <p class="micro-label">404 / A small detour</p>
    <h1 class="editorial-title mt-5">
      This page took
      <br />
      <span class="serif-text">another route.</span>
    </h1>
    <p class="section-copy mt-6">
      The link may have changed. Let’s get you back to the work.
    </p>
    <a class="primary-button mt-8" href={withBasePath("/")}>
      Back to the portfolio ↗
    </a>
  </section>
</BaseLayout>
