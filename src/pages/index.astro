---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CompanyMarquee from "../components/CompanyMarquee.astro";
import AgentWorkflow from "../components/AgentWorkflow.astro";
import CopyEmail from "../components/CopyEmail.astro";
import { site, withBasePath } from "../data/meta";
import { experiences } from "../data/experiences";
import { testimonials } from "../data/testimonials";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const capabilities = [
  {
    number: "01",
    title: "Interfaces with intent.",
    text: "Accessible, responsive React and TypeScript experiences that make complex workflows feel straightforward.",
    tags: "Frontend architecture / Design systems / Performance",
  },
  {
    number: "02",
    title: "Systems that hold up.",
    text: "Node.js services, secure integrations, and thoughtful data boundaries built to support the product as it grows.",
    tags: "APIs / Redis / Cloud integration",
  },
  {
    number: "03",
    title: "Agents with a purpose.",
    text: "Strands agents with AgentCore Runtime and Memory, connected to AWS Batch workloads and results in S3.",
    tags: "Strands / AgentCore / AWS Batch / S3",
  },
];
---

<BaseLayout description="M Rohan Pradev — lead full-stack engineer at Optum. Explore enterprise interfaces and AWS reagent optimization with Strands Agents, AgentCore, AWS Batch, and S3.">
  <Hero />
  <CompanyMarquee />
  <section id="work" class="section-shell" aria-labelledby="work-heading">
    <div class="section-intro-row" data-reveal>
      <div>
        <p class="micro-label">01 / Selected work</p>
        <h2 id="work-heading" class="editorial-title mt-4">
          Built to make
          <br />
          <span class="serif-text">a difference.</span>
        </h2>
      </div>
      <p class="section-aside">
        A closer look at the interfaces, systems, and agent workflows I’ve
        helped bring to life.
      </p>
    </div>
    <div class="work-list">
      {projects.map((project, index) => (
        <div data-reveal>
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            tech={project.data.tech}
            image={project.data.cover}
            alt={project.data.coverAlt}
            href={withBasePath(`/projects/${project.id}`)}
            company={project.data.company}
            duration={project.data.duration}
            outcomes={project.data.outcomes}
            featured={project.data.featured}
            headingLevel="h3"
            index={index + 1}
          />
        </div>
      ))}
    </div>
  </section>
  <section id="ai" class="section-shell" aria-labelledby="ai-heading">
    <div class="ai-feature" data-reveal>
      <div class="ai-feature-copy">
        <p class="micro-label">Inside the work / Optum</p>
        <h2 id="ai-heading" class="editorial-title mt-5">
          From a request
          <br />
          to <span class="serif-text">a result.</span>
        </h2>
        <p class="mt-6">
          I implemented a reagent optimization agent using Strands with
          AgentCore Runtime and Memory. The agent runs optimization through AWS
          Batch and stores results in Amazon S3.
        </p>
        <a
          class="text-link mt-5"
          href={withBasePath("/projects/reagent-optimization-agent")}
        >
          Explore the architecture <span aria-hidden="true">↗</span>
        </a>
      </div>
      <AgentWorkflow />
    </div>
  </section>
  <section
    id="capabilities"
    class="section-shell"
    aria-labelledby="capabilities-heading"
  >
    <div class="section-intro-row" data-reveal>
      <div>
        <p class="micro-label">02 / What I bring</p>
        <h2 id="capabilities-heading" class="editorial-title mt-4">
          Craft meets
          <br />
          <span class="serif-text">systems thinking.</span>
        </h2>
      </div>
      <p class="section-aside">
        From the first interaction to the service behind it, I care about how
        all the pieces work together.
      </p>
    </div>
    <div class="capability-list">
      {capabilities.map((item) => (
        <article class="capability-row" data-reveal>
          <span class="micro-label">{item.number}</span>
          <h3>{item.title}</h3>
          <div>
            <p>{item.text}</p>
            <p class="micro-label mt-4">{item.tags}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section
    id="experience"
    class="section-shell"
    aria-labelledby="experience-heading"
  >
    <div class="section-intro-row" data-reveal>
      <div>
        <p class="micro-label">03 / The journey</p>
        <h2 id="experience-heading" class="editorial-title mt-4">
          Built on
          <br />
          <span class="serif-text">real experience.</span>
        </h2>
      </div>
      <a href={withBasePath("/about")} class="text-link">
        The full story <span aria-hidden="true">↗</span>
      </a>
    </div>
    <ol class="experience-list">
      {experiences.map((experience, index) => (
        <li data-reveal>
          <span class="experience-index">0{index + 1}</span>
          <div>
            <p class="micro-label">{experience.company}</p>
            <h3 class="mt-2 text-xl font-medium text-slate-900">
              {experience.role}
            </h3>
            <p class="mt-3 text-sm leading-6 text-slate-500">
              {experience.stack.join(" · ")}
            </p>
          </div>
          <p class="experience-date">
            {experience.start} — {experience.end}
          </p>
        </li>
      ))}
    </ol>
  </section>
  <section
    id="testimonials"
    class="section-shell"
    aria-labelledby="testimonials-heading"
  >
    <div class="section-intro-row" data-reveal>
      <div>
        <p class="micro-label">04 / In good company</p>
        <h2 id="testimonials-heading" class="editorial-title mt-4">
          Better work.
          <br />
          <span class="serif-text">Together.</span>
        </h2>
      </div>
      <p class="section-aside">
        A few words from the engineers I’ve worked alongside.
      </p>
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {testimonials.map((testimonial) => (
        <div data-reveal>
          <TestimonialCard {...testimonial} />
        </div>
      ))}
    </div>
  </section>
  <section id="contact" class="section-shell" aria-labelledby="contact-heading">
    <div class="contact-panel" data-reveal>
      <p class="micro-label">Have something in mind?</p>
      <div class="contact-heading-row">
        <h2 id="contact-heading">
          Let’s build
          <br />
          <span class="serif-text">something great.</span>
        </h2>
        <a
          class="contact-circle"
          href={withBasePath("/contact")}
          aria-label="Start a conversation"
        >
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="contact-bottom">
        <a href={`mailto:${site.email}`} class="contact-email">
          {site.email}
        </a>
        <CopyEmail />
        <p>Based in Bengaluru. Open to the right team.</p>
      </div>
    </div>
  </section>
</BaseLayout>
