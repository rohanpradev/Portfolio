---
import BaseLayout from "../layouts/BaseLayout.astro";
import rohanPhoto from "../assets/profile/rohan-profile.jpeg";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CompanyMarquee from "../components/CompanyMarquee.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Badge from "../components/Badge.astro";
import { site } from "../data/meta";
import { projects } from "../data/projects";
import { experiences } from "../data/experiences";
import { skillGroups } from "../data/skills";
import { testimonials } from "../data/testimonials";

const heroStats = [
  { value: "9+", label: "Years in software" },
  { value: `${experiences.length}`, label: "Career chapters" },
  { value: "Enterprise + AI", label: "Delivery focus" },
];

const heroHighlights = [
  {
    title: "Own modules end to end",
    detail: "From UI architecture and API design to reviews, delivery, and production hardening.",
  },
  {
    title: "Cloud and workflow systems with real operating context",
    detail: "Redis caching, Azure services, external data sync, and backend orchestration built for production use.",
  },
  {
    title: "Modern products with AI readiness",
    detail: "Generative AI, retrieval workflows, and cloud-native systems without losing maintainability.",
  },
];

const focusAreas = [
  {
    icon: "layers",
    title: "React and TypeScript systems",
    note: "Architecture and maintainability",
    description:
      "Designing application surfaces that stay maintainable as requirements, teams, and data flows become more complex.",
  },
  {
    icon: "check",
    title: "Secure backend integration",
    note: "APIs, auth, and service boundaries",
    description:
      "Building REST APIs, auth flows, and service boundaries that are reliable enough for enterprise-grade products.",
  },
  {
    icon: "briefcase",
    title: "Azure and cloud-native delivery",
    note: "Operational resilience in production",
    description:
      "Using cloud services, containers, and infrastructure patterns that keep deployments resilient and understandable.",
  },
  {
    icon: "sparkles",
    title: "Generative AI integration",
    note: "Useful AI without system drift",
    description:
      "Applying OpenAI APIs, RAG patterns, and AI SDKs where they improve workflows without turning the system into a black box.",
  },
] as const;

const engagementPaths = [
  {
    title: "Enterprise product delivery",
    description: "Own a feature area or application module from architecture through release confidence.",
  },
  {
    title: "Frontend platform leadership",
    description: "Improve component systems, routing, data loading, and maintainable UI foundations.",
  },
  {
    title: "API and auth architecture",
    description: "Design cleaner service contracts, Swagger documentation, and secure identity integrations.",
  },
  {
    title: "AI-enabled experience design",
    description: "Integrate LLM and retrieval workflows in a way that still meets engineering quality standards.",
  },
];
---

<BaseLayout>
  <Hero
    title="M Rohan Pradev"
    subtitle="Senior Full-Stack Engineer delivering scalable, secure, and high-performance web applications across enterprise products, cloud-native backends, and AI-enabled experiences."
    ctaText="Explore Projects"
    ctaHref="#projects"
    resumeHref="/resume"
    resumeLabel="View Resume"
    photo={rohanPhoto}
    photoAlt="Photo of M Rohan Pradev"
    status={site.availability}
    location={site.location}
    email={site.email}
    stats={heroStats}
    highlights={heroHighlights}
    socialLinks={[
      { label: "GitHub", href: site.social.github },
      { label: "LinkedIn", href: site.social.linkedin },
    ]}
  />

  <div class="deferred-section">
    <CompanyMarquee />
  </div>

  <section id="projects" class="section-shell deferred-section py-16 sm:py-20 lg:py-24">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        eyebrow="Selected Work"
        title="A flagship smart manufacturing and workplace operations build."
        description="This project captures the strongest mix of frontend architecture, backend orchestration, caching strategy, cloud integration, and AI-enabled product work in the portfolio."
      />
      <a href="/projects" class="secondary-button w-fit">View case study</a>
    </div>

    <div class="mt-10">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <section class="section-shell deferred-section py-16 sm:py-20 lg:py-24">
    <div class="grid gap-6 lg:grid-cols-[0.94fr_1.06fr] lg:items-start">
      <div class="surface-card-strong p-8 sm:p-10">
        <p class="eyebrow">Professional Summary</p>
        <h2 class="mt-4 max-w-[16ch] text-[clamp(2.8rem,4vw,4.4rem)] font-semibold leading-[1.02] text-slate-900">
          Full-stack engineering shaped by security, scale, and delivery ownership.
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
          Senior engineer with 9+ years of experience delivering scalable, secure, and high-performance web applications.
          Strongest leverage comes from combining React and TypeScript frontend systems, Node.js service design, Azure-aligned
          backend integrations, and architecture reviews that keep products moving without accumulating chaos.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {engagementPaths.map((path) => (
            <article class="rounded-[20px] border border-slate-900/8 bg-white/80 p-5">
              <h3 class="text-lg font-semibold text-slate-900">{path.title}</h3>
              <p class="mt-2 text-sm leading-7 text-slate-600">{path.description}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="grid content-start gap-4 sm:grid-cols-2 lg:self-start">
        {focusAreas.map((item) => (
          <article class="surface-card h-fit p-5">
            <div class="space-y-3">
              <Badge variant="outline" icon={item.icon}>Focus Area</Badge>
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-slate-400">
                {item.note}
              </p>
            </div>
            <h3 class="mt-4 text-[1.8rem] font-semibold leading-[1.15] text-slate-900">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="experience" class="section-shell deferred-section py-16 sm:py-20 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1fr] lg:items-start">
      <SectionHeading
        eyebrow="Experience"
        title="From enterprise manufacturing and pensions to hospitality and full-stack platform work."
        description="The thread across roles is consistent: take ownership of critical modules, improve the engineering shape of the system, and help the team ship with more confidence."
      />
      <div class="space-y-5">
        {experiences.map((experience) => <ExperienceCard {...experience} />)}
      </div>
    </div>
  </section>

  <section id="skills" class="section-shell deferred-section py-16 sm:py-20 lg:py-24">
    <SectionHeading
      eyebrow="Technical Skills"
      title="A stack built around enterprise delivery, cloud-native systems, and modern AI integration."
      description="Breadth matters, but the real value is applying the right combination of frontend, backend, cloud, and architecture practices to the actual product constraint in front of the team."
    />

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {skillGroups.map((group) => (
        <article class="surface-card-strong p-6">
          <h3 class="text-2xl font-semibold text-slate-900">{group.title}</h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">{group.description}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {group.items.map((item) => <Badge variant="secondary">{item}</Badge>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="testimonials" class="section-shell deferred-section py-16 sm:py-20 lg:py-24">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1fr] lg:items-start">
      <SectionHeading
        eyebrow="Testimonials"
        title="Feedback from engineers who worked with Rohan directly."
        description="These recommendations reflect day-to-day collaboration quality, delivery consistency, and the technical trust built inside real teams."
      />

      <div class="grid gap-5 md:grid-cols-2">
        {testimonials.map((testimonial) => <TestimonialCard {...testimonial} />)}
      </div>
    </div>
  </section>

  <section id="contact" class="section-shell deferred-section py-16 sm:py-20 lg:py-24">
    <div class="surface-card-strong grid gap-8 p-8 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <SectionHeading
          eyebrow="Let's Build"
          title="Need someone who can handle the module, the architecture, and the review quality bar?"
          description="The landing page stays static and fast. The full Postmark-backed contact workflow lives on the dedicated contact page where the server-rendered form belongs."
        />

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {engagementPaths.map((path) => (
            <article class="rounded-[20px] border border-slate-900/8 bg-white/80 p-5">
              <h3 class="text-lg font-semibold text-slate-900">{path.title}</h3>
              <p class="mt-2 text-sm leading-7 text-slate-600">{path.description}</p>
            </article>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${site.email}`} class="primary-button">Email {site.author}</a>
          <a href="/contact" class="secondary-button">Open contact page</a>
        </div>
      </div>

      <div class="grid gap-4 lg:max-w-sm">
        <div class="rounded-[22px] border border-slate-900/8 bg-white/88 p-6 shadow-panel">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-slate-500">Fast Path</p>
          <p class="mt-3 text-2xl font-semibold text-slate-900">Direct conversation without slowing the homepage down.</p>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            For detailed project briefs, use the dedicated contact page with the secure server-backed form.
          </p>
        </div>

        <div class="rounded-[22px] border border-slate-900/8 bg-slate-900 p-6 text-white shadow-panel">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-white/70">Response Routes</p>
          <div class="mt-4 grid gap-3">
            <a href={`mailto:${site.email}`} class="secondary-button justify-start border-white/15 bg-white/10 px-4 py-3 text-white hover:bg-white/16">Email directly</a>
            <a href={site.social.linkedin} target="_blank" rel="noreferrer" class="secondary-button justify-start border-white/15 bg-white/10 px-4 py-3 text-white hover:bg-white/16">LinkedIn message</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
