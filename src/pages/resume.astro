---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, withBasePath } from "../data/meta";
import { experiences } from "../data/experiences";
import { PUBLIC_RESUME_URL } from "astro:env/client";
const configuredResumeUrl = PUBLIC_RESUME_URL?.trim() ?? "";
const resumeUrl = configuredResumeUrl.startsWith("/")
  ? withBasePath(configuredResumeUrl)
  : configuredResumeUrl;
const requestUrl = `mailto:${site.email}?subject=${encodeURIComponent("Résumé request")}`;
---

<BaseLayout
  title={`Résumé | ${site.name}`}
  description="Career overview for M Rohan Pradev, lead full-stack engineer at Optum working across enterprise interfaces and applied AI."
>
  <section class="section-shell intro-space" aria-labelledby="resume-heading">
    <div class="section-intro-row">
      <div>
        <p class="micro-label">Career at a glance</p>
        <h1 id="resume-heading" class="editorial-title mt-5">
          Experience with
          <br />
          <span class="serif-text">perspective.</span>
        </h1>
      </div>
      <a
        href={resumeUrl || requestUrl}
        class="primary-button"
        download={resumeUrl ? true : undefined}
      >
        {resumeUrl ? "Download résumé" : "Request my résumé"}{" "}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="resume-intro">
      Nine years across enterprise product delivery, frontend architecture,
      secure services, and applied AI. Currently leading full-stack engineering
      at Optum in Bengaluru.
    </p>
    <div class="resume-focus">
      <p class="micro-label">Recent work / Optum</p>
      <h2>Reagent optimization with Strands & AWS.</h2>
      <p>
        Implemented a Strands agent with AgentCore Runtime and Memory, using AWS
        Batch for reagent optimization and Amazon S3 for results.
      </p>
      <a
        href={withBasePath("/projects/reagent-optimization-agent")}
        class="text-link"
      >
        Read the case study ↗
      </a>
    </div>
    <ol class="experience-list">
      {experiences.map((experience, index) => (
        <li>
          <span class="experience-index">0{index + 1}</span>
          <div>
            <p class="micro-label">{experience.company}</p>
            <h2 class="text-xl mt-2">{experience.role}</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">
              {experience.stack.join(" · ")}
            </p>
          </div>
          <p class="experience-date">
            {experience.start} — {experience.end}
          </p>
        </li>
      ))}
    </ol>
    <div class="resume-bottom">
      <p>
        {resumeUrl
          ? "Download the PDF for the full career summary."
          : "The full résumé is available by email. Get in touch and I’ll share the latest version."}
      </p>
      <a class="text-link" href={withBasePath("/about")}>
        More about my work ↗
      </a>
    </div>
  </section>
</BaseLayout>
<style>
  .resume-intro {
    max-width: 48rem;
    margin-top: 2rem;
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--text-600);
  }
  .resume-focus {
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    margin-top: 3rem;
  }
  .resume-focus h2 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin-top: 1rem;
    line-height: 1.2;
  }
  .resume-focus > p:not(.micro-label) {
    max-width: 44rem;
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--text-600);
    margin-block: 1rem;
  }
  .resume-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    color: var(--text-600);
    font-size: 0.85rem;
    line-height: 1.8;
  }
  .resume-bottom > p {
    max-width: 32rem;
  }
</style>
