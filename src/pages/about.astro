---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site, withBasePath } from "../data/meta";
import { experiences } from "../data/experiences";
import { skillGroups } from "../data/skills";

const principles = [
	{
		title: "Own critical modules end to end",
		description:
			"Architecture, implementation, integration, review quality, and delivery pressure are handled as one connected responsibility.",
	},
	{
		title: "Favor clarity in secure systems",
		description:
			"Authentication, RBAC, and API contracts should make the product safer without turning the codebase into a maze.",
	},
	{
		title: "Use AI where it earns its place",
		description:
			"Generative AI and retrieval workflows are valuable when they improve the product and stay understandable to the engineering team.",
	},
];

const profileStats = [
	{ value: "9+", label: "Years experience" },
	{ value: `${experiences.length}`, label: "Enterprise roles" },
	{ value: `${skillGroups.length}`, label: "Capability groups" },
];

const aboutPageUrl = new URL(withBasePath("/about"), site.url).toString();
const structuredData = [
	{
		"@type": "AboutPage",
		"@id": `${aboutPageUrl}#about-page`,
		url: aboutPageUrl,
		name: `About ${site.name}`,
		description: "Background, working style, and technical strengths for M Rohan Pradev.",
		mainEntity: {
			"@id": `${site.homeUrl}#person`,
		},
		about: {
			"@id": `${site.homeUrl}#person`,
		},
	},
];
---

<BaseLayout
	title={`About | ${site.name}`}
	description="Background, working style, and technical strengths for M Rohan Pradev."
	structuredData={structuredData}
>
	<section
		id="about-overview"
		aria-labelledby="about-heading"
		class="section-shell intro-space"
	>
		<div class="surface-card-strong overflow-hidden p-10 sm:p-16 lg:p-24">
			<div class="grid gap-20 xl:grid-cols-[1.1fr_0.9fr] xl:items-center">
				<div data-reveal>
					<SectionHeading
						id="about-heading"
						as="h1"
						eyebrow="About"
						title="Engineering product systems that cannot afford drift."
						description="Senior React, TypeScript, and Node.js engineer with deep ownership across frontend architecture and secure service integration."
					/>

					<div class="mt-12 flex flex-wrap gap-5">
						<a href={withBasePath("/projects")} class="primary-button group px-10">
							View Flagship Work
							<svg aria-hidden="true" focusable="false" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
								<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
							</svg>
						</a>
						<a href={withBasePath("/contact")} class="secondary-button px-10">Start a Conversation</a>
					</div>
				</div>

				<div class="grid gap-8">
					<div class="grid gap-6 sm:grid-cols-3">
						{profileStats.map((item, index) => (
							<div
								class="surface-card bg-surface-tint border-none p-8 text-center"
								data-reveal
								style={`--reveal-delay: ${index * 80}ms;`}
							>
								<p class="text-4xl font-black text-slate-900 leading-none">{item.value}</p>
								<p class="mt-3 text-[0.65rem] font-bold uppercase tracking-widest text-slate-500">{item.label}</p>
							</div>
						))}
					</div>

					<div class="rounded-[40px] bg-slate-900 p-10 text-white shadow-float" data-reveal style="--reveal-delay: 180ms;">
						<p class="text-[0.7rem] font-black uppercase tracking-[0.3em] text-accent">Operating Lens</p>
						<p class="mt-6 text-xl font-bold leading-relaxed">
							Leverage comes from connecting product clarity, system boundaries, and delivery rigor so the team can ship without chaos.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section
		id="principles"
		aria-labelledby="principles-heading"
		class="section-shell"
	>
		<div class="grid gap-16 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
			<div data-reveal>
				<SectionHeading
					id="principles-heading"
					eyebrow="Principles"
					title="Engineering habits for growth."
					description="Practical patterns that keep enterprise work legible when requirements increase."
				/>
			</div>

			<div class="grid gap-6 md:grid-cols-3">
				{principles.map((principle, index) => (
					<article
						class="surface-card h-full p-10 transition-all hover:border-accent/40"
						data-reveal
						style={`--reveal-delay: ${index * 80}ms;`}
					>
						<h3 class="text-2xl font-black text-slate-900 leading-tight tracking-tight">{principle.title}</h3>
						<p class="mt-6 text-base leading-relaxed text-slate-500 font-medium">{principle.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section
		id="timeline"
		aria-labelledby="timeline-heading"
		class="section-shell"
	>
		<div class="grid gap-16 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
			<div data-reveal>
				<SectionHeading
					id="timeline-heading"
					eyebrow="Timeline"
					title="Structure and speed."
					description="Experience across manufacturing, pensions, and platform services."
				/>
			</div>
			<div class="space-y-10">
				{experiences.map((experience, index) => (
					<div data-reveal style={`--reveal-delay: ${index * 90}ms;`}>
						<ExperienceCard {...experience} />
					</div>
				))}
			</div>
		</div>
	</section>

	<section
		id="strengths"
		aria-labelledby="strengths-heading"
		class="section-shell"
	>
		<div class="grid gap-16 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
			<div data-reveal>
				<SectionHeading
					id="strengths-heading"
					eyebrow="Capabilities"
					title="Breadth across the stack."
					description="Deepest leverage in frontend systems, product architecture, and AI-enabled workflows."
				/>
			</div>

			<div class="grid gap-8">
				{skillGroups.map((group, index) => (
					<article
						class="surface-card p-10 transition-all hover:border-accent/40"
						data-reveal
						style={`--reveal-delay: ${index * 70}ms;`}
					>
						<h3 class="text-3xl font-black text-slate-900 tracking-tighter">{group.title}</h3>
						<p class="mt-4 text-lg font-bold text-slate-500 leading-relaxed">{group.description}</p>
						<div class="mt-10 flex flex-wrap gap-3">
							{group.items.map((item) => (
								<span class="text-[0.7rem] font-bold uppercase tracking-widest text-slate-600 bg-slate-900/5 px-4 py-2 rounded-xl border border-slate-900/5">
									{item}
								</span>
							))}
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
</BaseLayout>
