---
import type { ImageMetadata } from "astro";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollEffects from "../components/ScrollEffects.astro";
import { site, withBasePath } from "../data/meta";
import "../styles/globals.css";

type StructuredDataNode = Record<string, unknown>;

interface Props {
	title?: string;
	description?: string;
	image?: string | ImageMetadata;
	imageAlt?: string;
	noindex?: boolean;
	structuredData?: StructuredDataNode[];
	publishedTime?: string;
	modifiedTime?: string;
	openGraphType?: "website" | "article" | "profile";
}

const {
	title = site.title,
	description = site.description,
	image = site.ogImage,
	imageAlt = `${site.name} portfolio preview`,
	noindex = false,
	structuredData = [],
	publishedTime,
	modifiedTime,
	openGraphType = "website",
} = Astro.props as Props;

const canonical = new URL(Astro.url.pathname, site.url).toString();
const websiteId = `${site.homeUrl}#website`;
const personId = `${site.homeUrl}#person`;
const pageId = `${canonical}#webpage`;
const resolvedImage = typeof image === "string" ? image : image.src;
const imageWidth = typeof image === "string" ? site.ogImageWidth : image.width;
const imageHeight = typeof image === "string" ? site.ogImageHeight : image.height;
const imageType =
	resolvedImage.endsWith(".png")
		? "image/png"
		: resolvedImage.endsWith(".webp")
			? "image/webp"
			: resolvedImage.endsWith(".jpg") || resolvedImage.endsWith(".jpeg")
				? "image/jpeg"
				: resolvedImage.endsWith(".avif")
					? "image/avif"
					: undefined;
const socialImage = resolvedImage.startsWith("http")
	? resolvedImage
	: new URL(resolvedImage, site.url).toString();
const sameAs = [site.social.github, site.social.linkedin].filter(Boolean);
const profileImage = new URL(site.profilePhoto.src, site.url).toString();
const pathnameWithoutBase =
	site.basePath && Astro.url.pathname.startsWith(site.basePath)
		? Astro.url.pathname.slice(site.basePath.length) || "/"
		: Astro.url.pathname;
const pathname = pathnameWithoutBase.replace(/\/$/, "") || "/";
const isHomePage = pathname === "/";
const segments = pathname === "/" ? [] : pathname.slice(1).split("/");
const breadcrumbs = [
	{ name: "Home", item: new URL(withBasePath("/"), site.url).toString() },
	...segments.map((segment, index) => ({
		name: segment
			.split("-")
			.map((part) => part.charAt(0).toUpperCase() + part.slice(1))
			.join(" "),
		item: new URL(
			withBasePath(`/${segments.slice(0, index + 1).join("/")}`),
			site.url,
		).toString(),
	})),
];

const baseGraph: StructuredDataNode[] = [
	{
		"@type": "WebSite",
		"@id": websiteId,
		name: site.name,
		url: site.homeUrl,
		description: site.description,
		inLanguage: "en-IN",
	},
	{
		"@type": "Person",
		"@id": personId,
		name: site.author,
		url: site.homeUrl,
		image: profileImage,
		jobTitle: site.role,
		description: site.headline,
		email: site.email,
		address: {
			"@type": "PostalAddress",
			addressLocality: site.location,
		},
		knowsAbout: site.expertise,
		sameAs,
	},
	{
		"@type": "WebPage",
		"@id": pageId,
		name: title,
		url: canonical,
		description,
		isPartOf: {
			"@id": websiteId,
		},
		about: {
			"@id": personId,
		},
		primaryImageOfPage: {
			"@type": "ImageObject",
			url: socialImage,
		},
	},
];

if (isHomePage) {
	baseGraph.push({
		"@type": "ProfilePage",
		"@id": `${site.homeUrl}#profile`,
		url: site.homeUrl,
		name: site.title,
		description: site.shortDescription,
		mainEntity: {
			"@id": personId,
		},
		isPartOf: {
			"@id": websiteId,
		},
	});
}

if (breadcrumbs.length > 1) {
	baseGraph.push({
		"@type": "BreadcrumbList",
		itemListElement: breadcrumbs.map((crumb, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: crumb.name,
			item: crumb.item,
		})),
	});
}

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [...baseGraph, ...structuredData],
};

const robots = noindex
	? "noindex,nofollow"
	: "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.author} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#130d18" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta name="robots" content={robots} />
		<meta name="googlebot" content={robots} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en-IN" href={canonical} />
		<link rel="alternate" hreflang="x-default" href={canonical} />
		<Font cssVariable="--font-roboto" preload />
		<link rel="icon" href={withBasePath("/favicon.svg")} type="image/svg+xml" />
		<link rel="shortcut icon" href={withBasePath("/favicon.svg")} />
		<link rel="apple-touch-icon" href={withBasePath("/apple-touch-icon.png")} />
		<link rel="manifest" href={withBasePath("/site.webmanifest")} />
		<link
			rel="sitemap"
			type="application/xml"
			href={new URL(withBasePath("/sitemap-index.xml"), site.url).toString()}
		/>

		<meta property="og:type" content={openGraphType} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:secure_url" content={socialImage} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:image:width" content={String(imageWidth)} />
		<meta property="og:image:height" content={String(imageHeight)} />
		{imageType && <meta property="og:image:type" content={imageType} />}
		<meta property="og:locale" content="en_IN" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="twitter:image:alt" content={imageAlt} />

		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="selection:bg-primary selection:text-white">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-sm"
		>
			Skip to content
		</a>
		<Header />
		<main id="main-content" class="page-stack pb-12 sm:pb-16">
			<slot />
		</main>
		<Footer />
		<ScrollEffects />
	</body>
</html>
